{
    "name": "git.wtf",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "astro dev",
        "prebuild": "node scripts/make-panels.mjs && node scripts/copy-cuts.mjs",
        "build": "astro build",
        "build:fixture": "node scripts/ghost-to-archive.mjs tests/fixtures/ghost-export.json --out tests/fixtures/archive --no-url-list && GITWTF_FIXTURE=1 node scripts/make-panels.mjs && GITWTF_FIXTURE=1 node scripts/copy-cuts.mjs && GITWTF_FIXTURE=1 astro build",
        "redirects": "node src/redirects.mjs",
        "preview": "node scripts/serve-dist.mjs dist 8787",
        "check": "astro check",
        "convert": "node scripts/ghost-to-archive.mjs",
        "check-urls": "node scripts/check-urls.mjs",
        "publish-incident": "node scripts/publish-incident.mjs",
        "list-sources": "node scripts/list-sources.mjs"
    },
    "dependencies": {
        "@astrojs/rss": "^4.0.0",
        "@astrojs/sitemap": "^3.6.0",
        "@fontsource-variable/big-shoulders-display": "^5.3.0",
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@resvg/resvg-js": "^2.6.2",
        "astro": "^7.4.7",
        "gray-matter": "^4.0.3",
        "gsap": "^3.15.1",
        "satori": "^0.63.2"
    },
    "devDependencies": {
        "@fontsource/big-shoulders-display": "^5.3.0",
        "@fontsource/jetbrains-mono": "^5.3.0",
        "cheerio": "^1.2.0",
        "opentype.js": "^1.3.4",
        "sharp": "^0.35.5",
        "wrangler": "^4.158.0"
    },
    "engines": {
        "node": ">=22"
    }
}
