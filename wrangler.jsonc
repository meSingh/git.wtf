{
    // Static site on Cloudflare Workers (assets only, no Worker code).
    // Deployed by Workers Builds from the connected GitHub repository. Dashboard settings:
    //   build command: npm run build      deploy command: npx wrangler deploy      root directory: /
    // Non-production branches get a preview URL (versions upload); master deploys for real.
    // The custom domain (git.wtf) is added here only when the switch from Ghost is approved:
    //   "routes": [{ "pattern": "git.wtf", "custom_domain": true }]
    "name": "gitwtf",
    "compatibility_date": "2026-11-06",
    "assets": {
        "directory": "./dist",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page"
    }
}
