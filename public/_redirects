# Old git.wtf URLs. Cloudflare serves this file natively. Order matters: first match wins.

# Ghost listing pages: every tag, category, author and paginated page goes to the archive index.
/tag/*            /archive/   301
/category/*       /archive/   301
/author/*         /archive/   301
/page/*           /archive/   301

# Ghost AMP copies of every post.
/:slug/amp/       /:slug/     301
/:slug/amp        /:slug/     301

# Feeds and sitemaps.
/rss/             /rss.xml    301
/rss              /rss.xml    301
/feed             /rss.xml    301
/feed/            /rss.xml    301
/sitemap.xml      /sitemap-index.xml 301
/sitemap-posts.xml   /sitemap-index.xml 301
/sitemap-pages.xml   /sitemap-index.xml 301
/sitemap-tags.xml    /sitemap-index.xml 301
/sitemap-authors.xml /sitemap-index.xml 301

# Ghost members, portal and admin. Comments and the newsletter are gone.
/members/*        /           301
/signup/          /           301
/signin/          /           301
/ghost/*          /           301
/webmentions/*    /           301

