---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE, formatDate } from '../lib/site';

export async function getStaticPaths() {
    const all = (await getCollection('archive')).sort((a, b) => (a.data.published_at < b.data.published_at ? 1 : -1));
    const posts = all.filter((p) => p.data.type === 'post');
    return all.map((entry) => {
        const i = posts.indexOf(entry);
        return {
            params: { slug: entry.id },
            props: { entry, newer: i > 0 ? posts[i - 1] : null, older: i >= 0 ? posts[i + 1] ?? null : null },
        };
    });
}
const { entry, newer, older } = Astro.props;
const d = entry.data;
const isPost = d.type === 'post';
const jsonld = isPost
    ? {
          '@context': 'https://schema.org',
          '@type': 'Article',
          headline: d.title,
          datePublished: d.published_at,
          dateModified: d.updated_at ?? d.published_at,
          url: new URL(`/${entry.id}/`, SITE.url).toString(),
          image: d.feature_image ? new URL(d.feature_image, SITE.url).toString() : undefined,
          author: { '@type': 'Person', name: d.authors[0] ?? SITE.owner.name, url: SITE.owner.url },
          publisher: { '@type': 'Organization', name: 'GIT.WTF!?!', url: SITE.url },
      }
    : undefined;
---
<Base title={d.meta_title ?? `${d.title} | git.wtf`} description={d.meta_description ?? d.excerpt} image={d.feature_image ?? '/share.png'} canonical={d.canonical_url ?? undefined} type={isPost ? 'article' : 'website'} jsonld={jsonld}>
    <article class="post">
        <header>
            <h1>{d.title}</h1>
            {isPost && (
                <p class="meta">
                    <time datetime={d.published_at}>{formatDate(d.published_at.slice(0, 10))}</time>
                    {d.authors.length > 0 && <span> · {d.authors.join(', ')}</span>}
                    <span> · <a href="/archive/">archive</a></span>
                </p>
            )}
        </header>
        {d.feature_image && <img class="feature" src={d.feature_image} alt="" loading="lazy" />}
        <div class="content" set:html={d.html} />
        {d.tags.length > 0 && <p class="tags">Tagged: {d.tags.join(', ')}</p>}
        {isPost && (
            <nav class="nav">
                <span>{older && <a href={`/${older.id}/`}>&larr; {older.data.title}</a>}</span>
                <span>{newer && <a href={`/${newer.id}/`}>{newer.data.title} &rarr;</a>}</span>
            </nav>
        )}
    </article>
</Base>
