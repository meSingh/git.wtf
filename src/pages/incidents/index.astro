---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/pages.css';
import IncidentCards from '../../components/IncidentCards.astro';
import Score from '../../components/Score.astro';
import Streak from '../../components/Streak.astro';
import { sortIncidents } from '../../lib/site';
const incidents = sortIncidents(await getCollection('incidents'));
---
<Base title="The fuck-ups | git.wtf" image="/og/incidents.png" description="Every Git and AI fuck-up we have caught, newest first, each with its status.">
    <main class="page">
        <div class="page-head inc-head"><h1>The fuck-ups</h1><p class="lede">Every Git and AI fuck-up we have caught, newest first. Each one comes with a status. Few of them are good.</p></div>
        <div class="iwrap"><IncidentCards incidents={incidents} /></div>
        <section class="beat beat-score" aria-labelledby="score-h"><Score incidents={incidents} /></section>
        <section class="beat beat-streak" aria-labelledby="streak-h"><Streak incidents={incidents} /></section>
    </main>
</Base>
