---
import Base from '../../layouts/Base.astro';
import '../../styles/hero.css';
import { href } from '../../lib/site';
const concepts = [
    ['a', 'Lights on', 'The whole screen is the sign. A lamp flickers, three banks of floodlights come up left to right, the flaps cascade and the screen jolts as they settle.'],
    ['b', 'The crash', 'A full-screen terminal session goes wrong at speed, and the sign slams down over it like a shutter. The session keeps running faint behind it.'],
    ['c', 'The odometer', 'One number at the height of the screen rolls down from the days since the first incident to the real count, and the headline locks in word by word.'],
] as const;
---
<Base title="Hero lab | git.wtf" description="Three openings for the homepage." noindex>
    <main class="page lab-index">
        <div class="page-head">
            <h1>Hero lab</h1>
            <p class="meta"><span>Three openings for the homepage. Each plays once on load; press R on a page to replay it.</span></p>
        </div>
        <div class="lab-grid">
            {concepts.map(([k, name, text]) => (
                <section class="lab-card">
                    <a class="lab-frame" href={href(`/hero/${k}/`)} aria-label={`Open ${name} full screen`}>
                        <iframe src={href(`/hero/${k}/?embed`)} title={name} loading="eager" tabindex="-1" scrolling="no"></iframe>
                    </a>
                    <div class="lab-meta">
                        <h2><span class="k">{k.toUpperCase()}</span> {name}</h2>
                        <p>{text}</p>
                        <p class="lab-links"><a href={href(`/hero/${k}/`)}>Open full screen</a> <button type="button" data-reload={k}>Replay here</button></p>
                    </div>
                </section>
            ))}
        </div>
        <p class="lab-note prose">The homepage at <a href={href('/')}>/</a> is unchanged apart from the mark. The pick replaces its first screen; the rest of the page is then rebuilt around it.</p>
    </main>
    <script>
        // Each preview is a real 1440 x 900 page scaled into its card.
        const fit = () => document.querySelectorAll<HTMLElement>('.lab-frame').forEach((f) => {
            const s = f.clientWidth / 1440;
            const i = f.querySelector('iframe')!;
            i.style.transform = `scale(${s})`;
        });
        fit();
        addEventListener('resize', fit);
        document.querySelectorAll<HTMLButtonElement>('[data-reload]').forEach((b) => b.addEventListener('click', () => {
            const i = b.closest('.lab-card')!.querySelector('iframe')!;
            i.src = i.src;
        }));
    </script>
</Base>
