---
import Lab from '../../layouts/Lab.astro';
import Flaps from '../../components/Flaps.astro';
import Logo from '../../components/Logo.astro';
import FitText from '../../components/FitText.astro';
import { heroData } from '../../lib/hero';
import { href } from '../../lib/site';
const d = await heroData();
---
<Lab title="A. Lights on" current="a">
    <main class="ha" id="hero">
        <div class="ha-stripes" aria-hidden="true"></div>
        <div class="ha-face">
            <i class="rv tl" aria-hidden="true"></i><i class="rv tr" aria-hidden="true"></i><i class="rv bl" aria-hidden="true"></i><i class="rv br" aria-hidden="true"></i>
            <h1 class="ha-head">
                <span class="visually-hidden">Days since the last Git fuck-up</span>
                <FitText class="wide" text="DAYS SINCE THE LAST GIT FUCK-UP" width={1251.9} />
                <span class="narrow"><FitText text="DAYS SINCE THE LAST" width={772.4} /><FitText text="GIT FUCK-UP" width={457.5} /></span>
            </h1>
            <div class="ha-board">
                <Flaps value={d.days} min={2} since={d.since} class="ha-flaps" label={`${d.days} days since the last Git fuck-up`} />
            </div>
            <div class="ha-foot ha-late">
                <a class="brand" href={href('/')} aria-label="Git.WTF, home"><Logo height="clamp(1.4rem, 3.4vh, 2.2rem)" /></a>
                <a class="hero-today" href={href(d.path)}>Today's: <em>{d.title}</em><span aria-hidden="true"> &darr;</span></a>
            </div>
            <div class="ha-scan" aria-hidden="true"></div>
        </div>
        <div class="ha-bloom" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="ha-dark" aria-hidden="true"><i></i><i></i><i></i></div>
    </main>
    <script>
        import '../../scripts/hero-a';
    </script>
</Lab>
