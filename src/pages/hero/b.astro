---
import Lab from '../../layouts/Lab.astro';
import Flaps from '../../components/Flaps.astro';
import Logo from '../../components/Logo.astro';
import FitText from '../../components/FitText.astro';
import { heroData } from '../../lib/hero';
import { href } from '../../lib/site';
const d = await heroData();
// The session: calm, then wrong. Commands are typed; output prints whole.
const session: [string, string][] = [
    ['cmd', 'git checkout main'],
    ['out', "Switched to branch 'main'"],
    ['out', "Your branch is behind 'origin/main' by 12 commits."],
    ['cmd', 'git pull'],
    ['out', 'Updating 3f9a1c2..e71b0d4'],
    ['out', 'Fast-forward'],
    ['out', ' src/index.ts | 48 +++++-----'],
    ['cmd', 'git rebase -i HEAD~12'],
    ['out', 'Auto-merging src/index.ts'],
    ['err', 'CONFLICT (content): Merge conflict in src/index.ts'],
    ['err', 'error: could not apply 9b2e4f1... fix the fix'],
    ['out', 'hint: Resolve all conflicts manually, then run "git rebase --continue".'],
    ['cmd', 'git push --force'],
    ['out', 'To github.com:team/platform.git'],
    ['err', ' ! [rejected]        main -> main (stale info)'],
    ['err', 'fatal: the remote end hung up unexpectedly'],
    ['out', 'HEAD detached at 7c1d9e3'],
    ['err', 'error: failed to push some refs to github.com:team/platform.git'],
    ['err', 'fatal: refusing to merge unrelated histories'],
    ['out', 'HEAD detached at 7c1d9e3'],
    ['err', ' ! [remote rejected] main -> main (protected branch hook declined)'],
    ['err', 'fatal: bad object HEAD'],
    ['err', 'error: could not apply 9b2e4f1... fix the fix'],
    ['out', ' + 3f9a1c2...e71b0d4 main -> main (forced update)'],
    ['err', 'fatal: the remote end hung up unexpectedly'],
    ['out', 'HEAD detached at 7c1d9e3'],
    ['err', ' ! [rejected]        main -> main (non-fast-forward)'],
    ['err', 'error: failed to push some refs'],
    ['err', 'fatal: not a git repository (or any of the parent directories): .git'],
];
---
<Lab title="B. The crash" current="b">
    <main class="hb" id="hero">
        <div class="hb-term" aria-hidden="true">
            <div class="hb-lines">
                {session.map(([k, t]) => (
                    <div class={`ln ${k}`}>{k === 'cmd' ? <><span class="ps">$ </span><span class="tx">{t}</span></> : t}</div>
                ))}
                <div class="ln cmd live"><span class="ps">$ </span><span class="cur"></span></div>
            </div>
        </div>
        <div class="hb-tear" aria-hidden="true"></div>
        <section class="hb-shutter">
            <div class="hb-face">
                <h1 class="hb-head">
                    <span class="visually-hidden">Days since the last Git fuck-up</span>
                    <FitText class="wide" text="DAYS SINCE THE LAST GIT FUCK-UP" width={1251.9} />
                    <span class="narrow"><FitText text="DAYS SINCE THE LAST" width={772.4} /><FitText text="GIT FUCK-UP" width={457.5} /></span>
                </h1>
                <div class="hb-board">
                    <Flaps value={d.days} min={2} since={d.since} class="hb-flaps" label={`${d.days} days since the last Git fuck-up`} />
                </div>
                <div class="hb-foot">
                    <a class="brand" href={href('/')} aria-label="Git.WTF, home"><Logo height="clamp(1.4rem, 3.2vh, 2.1rem)" /></a>
                    <a class="hero-today" href={href(d.path)}>Today's: <em>{d.title}</em><span aria-hidden="true"> &darr;</span></a>
                </div>
            </div>
            <div class="hb-rail" aria-hidden="true"><span></span></div>
        </section>
    </main>
    <script>
        import '../../scripts/hero-b';
    </script>
</Lab>
