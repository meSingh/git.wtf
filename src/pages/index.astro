---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Odo from '../components/Odo.astro';
import Strip from '../components/Strip.astro';
import Record from '../components/Record.astro';
import Score from '../components/Score.astro';
import Streak from '../components/Streak.astro';
import Confess from '../components/Confess.astro';
import { heroData } from '../lib/hero';
import { SITE, href, incidentPath, sortIncidents } from '../lib/site';

const incidents = sortIncidents(await getCollection('incidents'));
const latest = incidents[0] ?? null;
const d = await heroData();
const image = latest ? `${incidentPath(latest)}share.png` : '/share.png';
const words = ['DAYS', 'SINCE', 'THE', 'LAST', 'GIT', 'FUCK-UP'];
---
<Base title={`${SITE.title} | git.wtf`} image={image} badge={false} motionFlag>
    <section class="hh" id="hero">
        <svg class="hh-defs" width="0" height="0" aria-hidden="true"><filter id="vblur" x="0" y="-20%" width="100%" height="140%"><feGaussianBlur stdDeviation="0 0" /></filter></svg>
        <div class="hh-odo-wrap" id="hero-odo">
            <Odo value={d.days} from={Math.max(d.total, d.days + 20)} min={2} since={d.since} class="hh-odo wheel" label={`${d.days} days since the last Git fuck-up`} />
        </div>
        <h1 class="hh-words">
            <span class="visually-hidden">Days since the last Git fuck-up</span>
            {words.map((w) => <span class="w" aria-hidden="true">{w}</span>)}
        </h1>
        {latest && <div class="hh-foot"><a class="hero-today hh-today" href="#today">Today's: <em>{latest.data.title}</em><span aria-hidden="true"> &darr;</span></a></div>}
        <div class="hh-wipe" aria-hidden="true"></div>
    </section>

    {latest ? (
        <section class="beat beat-today" id="today" aria-labelledby="today-h">
            <div class="col today-head">
                <p class="today-kicker">Today's fuck-up</p>
                <h2 class="today-title" id="today-h"><a href={href(incidentPath(latest))}><span class="visually-hidden">{latest.data.title}</span><span aria-hidden="true">{latest.data.title.split(/\s+/).map((w, i, a) => <><span class="tw">{w}</span>{i < a.length - 1 && ' '}</>)}</span></a></h2>
            </div>
            <Strip incident={latest} class="col today-strip" />
            <p class="col today-more"><a href={href(incidentPath(latest))}>Read the full fuck-up <span aria-hidden="true">&rarr;</span></a></p>
        </section>
    ) : (
        <section class="beat col" id="today"><p class="note">No incident on record yet. The first one lands when the daily search finds one that passes the rules.</p></section>
    )}

    {incidents.length > 1 && (
        <section class="beat beat-record" id="record" aria-labelledby="record-h">
            <Record incidents={incidents} />
        </section>
    )}

    <section class="beat beat-score" id="score" aria-labelledby="score-h">
        <Score incidents={incidents} />
    </section>

    <section class="beat beat-streak" id="streak" aria-labelledby="streak-h">
        <Streak incidents={incidents} />
    </section>

    <section class="beat beat-confess" id="confess" aria-labelledby="confess-h">
        <Confess />
    </section>

    <section class="beat beat-story" id="story" aria-labelledby="story-h">
        <div class="col">
            <div class="beat-head"><h2 id="story-h" data-lock>The story</h2></div>
            <div class="story">
                <p>For 10 years git.wtf was a blog about fixing Git, written for people who had just fucked up and were looking for the fix. Then AI came into the picture and started doing the fixes for them, and the questions stopped coming here.</p>
                <p>We noticed, envied and wanted revenge. So we started counting AI's fuck-ups alongside the Git fuck-ups.</p>
                <p>AI now runs Git commands by itself, and a good many of the fuck-ups are now its own. We keep track of those with delight.</p>
                <p>By the way, the old blog posts are still here, unchanged, in the archive. <a href={href('/archive/')}>Find them here.</a></p>
            </div>
        </div>
    </section>

    <div class="wipes" aria-hidden="true"><i data-wipe="record"></i><i data-wipe="score"></i><i data-wipe="confess"></i></div>

    <script>
        // The motion loads after the first frame is painted, so the opening's still is never kept waiting for it.
        requestAnimationFrame(() => requestAnimationFrame(() => import('../scripts/home')));
    </script>
</Base>
