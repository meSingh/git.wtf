---
// The homepage (v6, Mandeep's notes of 7 Nov 2026): the counter, then today's episode full screen, playing by
// itself while it is in view and never holding the page's scroll, the story detail, share, the record back in time, the score, the streak, confess,
// the story. The first paint carries the counter and the episode's poster only; the cut, its engine and its sound
// load afterwards.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Odo from '../components/Odo.astro';
import Strip from '../components/Strip.astro';
import Record from '../components/Record.astro';
import Score from '../components/Score.astro';
import Streak from '../components/Streak.astro';
import Confess from '../components/Confess.astro';
import ShareCut from '../components/ShareCut.astro';
import { heroData } from '../lib/hero';
import { SITE, href, incidentPath, sortIncidents } from '../lib/site';
import { cutAssets, shotList } from '../lib/cuts';

const incidents = sortIncidents(await getCollection('incidents'));
const latest = incidents[0] ?? null;
const d = await heroData();
const image = latest ? `${incidentPath(latest)}share.png` : '/share.png';
const words = SITE.lineWords;
const list = latest ? shotList(latest.id) : null;
const cut = latest && list ? cutAssets(latest.id) : null;
const posterOf = (f: string | null) => (latest && f ? href(`/cuts/${latest.id}/${f}`) : null);
const poster = posterOf(cut?.poster ?? null), posterTall = posterOf(cut?.posterTall ?? null);
const hasCut = !!(cut && poster && list);
const jsonld = {
    '@context': 'https://schema.org',
    '@graph': [
        { '@type': 'Organization', '@id': `${SITE.url}/#org`, name: SITE.name, url: `${SITE.url}/`, logo: `${SITE.url}/apple-touch-icon.png`, sameAs: [SITE.x, `https://github.com/${SITE.repo}`], founder: { '@type': 'Person', name: SITE.owner.name } },
        { '@type': 'WebSite', '@id': `${SITE.url}/#site`, name: SITE.name, alternateName: SITE.line, url: `${SITE.url}/`, description: SITE.description, inLanguage: 'en', publisher: { '@id': `${SITE.url}/#org` } },
    ],
};
---
<Base title={`${SITE.title} | git.wtf`} image={image} badge={false} motionFlag jsonld={jsonld}>
    <section class="hh" id="hero">
        <svg class="hh-defs" width="0" height="0" aria-hidden="true"><filter id="vblur" x="0" y="-20%" width="100%" height="140%"><feGaussianBlur stdDeviation="0 0" /></filter></svg>
        <div class="hh-odo-wrap" id="hero-odo">
            <Odo value={d.days} from={Math.max(d.total, d.days + 20)} min={2} since={d.since} class="hh-odo wheel" label={`${d.days} ${SITE.line.replace(/^Days /, 'days ')}`} />
        </div>
        <h1 class="hh-words">
            <span class="visually-hidden">{SITE.line}</span>
            {words.map((w) => <span class="w" aria-hidden="true">{w}</span>)}
        </h1>
        <div class="hh-foot">
            {latest && <a class="hero-today hh-today" href={hasCut ? '#cut' : '#today'}>Today's: <em>{latest.data.title}</em><span aria-hidden="true"> &darr;</span></a>}
            <a class="hh-hint" href={hasCut ? '#cut' : '#today'} data-hint><span class="hh-hint-w">Keep scrolling. It gets worse.</span><span class="hh-hint-a" aria-hidden="true"></span></a>
        </div>
        <div class="hh-wipe" aria-hidden="true"></div>
    </section>

    {hasCut ? (
        <>
            <section class="beat beat-cut" id="cut" aria-label={`Today's fuck-up: ${latest!.data.title}, as an anime cutscene`}>
                <div class="ep" id="cut-stage" data-player={href(`${incidentPath(latest!)}cut/player/`)} data-cut={latest!.id} data-n={list!.shots.length}>
                    <div class="ep-box" data-cut-box>
                        <picture class="ep-poster">
                            {posterTall && <source media="(max-aspect-ratio: 4/5)" srcset={posterTall} width="720" height="1280" />}
                            <img src={poster} width="1280" height="720" alt="" decoding="async" loading="lazy" />
                        </picture>
                    </div>
                    <a class="ep-down" href="#detail" data-cut-down><span class="ep-down-w">Keep scrolling. It gets worse.</span><span class="ep-down-a" aria-hidden="true"></span></a>
                    <button type="button" class="ep-skip" data-cut-skip>Skip episode <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 2l8 6-8 6z" /><rect x="11.5" y="2" width="2.5" height="12" /></svg></button>
                    <div class="ep-bar">
                        <p class="ep-ctls">
                            <button type="button" class="ep-replay" data-cut-replay aria-label="Replay the episode"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5V1L7 6l5 5V7a6 6 0 1 1-6 6H4a8 8 0 1 0 8-8z" /></svg><span>Replay</span></button>
                            <span class="ep-sound" data-cut-sound-slot></span>
                            <span class="ep-count" data-cut-count aria-live="off"></span>
                        </p>
                        <p class="ep-today"><span class="ep-k">Today's fuck-up:</span> <a href={href(incidentPath(latest!))}>{latest!.data.title}</a></p>
                    </div>
                </div>
            </section>
            <section class="beat beat-detail over" id="detail" aria-labelledby="detail-h">
                <div class="col detail">
                    <div class="detail-text">
                        <p class="today-kicker">What actually happened</p>
                        <h2 id="detail-h" class="detail-h">{latest!.data.title}</h2>
                        <div class="detail-lines">
                            <p>Twelve AI agents shared one checkout. Thirty-two minutes later, 2,309 uncommitted files were gone.</p>
                            <p>The repair step had made a rescue branch. The cleanup step deleted it, as cleanup steps do.</p>
                            <p>The files came back from a side job that copied everything, every cycle. The guard added next said no to 1,477 more attempts to tidy.</p>
                        </div>
                        <p class="after-links"><a class="after-main" href={href(incidentPath(latest!))}>Read what happened <span aria-hidden="true">&rarr;</span></a><a class="after-alt" href={href(`${incidentPath(latest!)}cut/`)}>Open the cut full screen</a></p>
                    </div>
                    <figure class="detail-pic" data-detail-pic>
                        {cut!.story ? (
                            <img src={href(`/cuts/${latest!.id}/${cut!.story}`)} srcset={cut!.story2x ? `${href(`/cuts/${latest!.id}/${cut!.story}`)} 1200w, ${href(`/cuts/${latest!.id}/${cut!.story2x}`)} 2400w` : undefined} sizes="(min-width: 761px) min(38rem, 55vw), 100vw" width="1200" height="630" alt="DEV sips from his mug beside a desk while a gate arm bonks an agent with a broom; a queue of agents with brooms waits behind it, and the small grey helper stands by a tall stack of copied pages." loading="lazy" decoding="async" />
                        ) : (
                            <div class="detail-slot" role="img" aria-label="Image to come: a still of this incident">1200 &times; 630</div>
                        )}
                    </figure>
                </div>
            </section>
        </>
    ) : latest ? (
        <section class="beat beat-today" id="today" aria-labelledby="today-h">
            <div class="col today-head">
                <p class="today-kicker">Today's fuck-up</p>
                <h2 class="today-title" id="today-h"><a href={href(incidentPath(latest))}>{latest.data.title}</a></h2>
            </div>
            <Strip incident={latest} class="col today-strip" />
            <p class="col today-more"><a href={href(incidentPath(latest))}>Read the full fuck-up <span aria-hidden="true">&rarr;</span></a></p>
        </section>
    ) : (
        <section class="beat col" id="today"><p class="note">No incident on record yet. The first one lands when the daily search finds one that passes the rules.</p></section>
    )}

    {latest && (
        <div class="beat over" id="share">
            <ShareCut title={latest.data.title} status={latest.data.status} url={new URL(incidentPath(latest), SITE.url).toString()} image={href(`${incidentPath(latest)}share.png`)} video={cut?.video ? href(`/cuts/${latest.id}/${cut.video}`) : null} slug={latest.id} episode={list ? { episode: list.episode, title: list.title } : null} picture={false} />
        </div>
    )}

    {incidents.length > 0 && (
        <section class="beat beat-record over" id="record" aria-labelledby="record-h">
            <Record incidents={incidents} />
        </section>
    )}

    <section class="beat beat-score over" id="score" aria-labelledby="score-h">
        <Score incidents={incidents} />
    </section>

    <section class="beat beat-streak over" id="streak" aria-labelledby="streak-h">
        <Streak incidents={incidents} />
    </section>

    <section class="beat beat-confess over" id="confess" aria-labelledby="confess-h">
        <Confess />
    </section>

    <section class="beat beat-story over" id="story" aria-labelledby="story-h">
        <div class="col">
            <div class="beat-head"><h2 id="story-h" data-lock>The story</h2></div>
            <div class="story">
                <p>For 10 years git.wtf was a blog about fixing Git, written for people who had <em>just</em> fucked up and were looking for the fix. Then AI came into the picture and started doing the fixes for them, and the questions stopped coming here.</p>
                <p><mark>We noticed, envied and wanted revenge.</mark> So we started counting AI's fuck-ups alongside the Git fuck-ups.</p>
                <p>AI now runs Git commands by itself, and <mark>a good many of the fuck-ups are now its own</mark>. We keep track of those with delight.</p>
                <p>By the way, the old blog posts are still here, unchanged, in the archive.</p>
            </div>
            <p class="story-go"><a class="story-btn" href={href('/archive/')}>Read the old blog: 67 posts</a></p>
        </div>
    </section>

    <div class="wipes" aria-hidden="true"><i data-wipe="record"></i><i data-wipe="score"></i><i data-wipe="confess"></i></div>

    <script>
        // The motion loads after the first frame is painted, so the opening's still is never kept waiting for it.
        requestAnimationFrame(() => requestAnimationFrame(() => import('../scripts/home')));
    </script>
</Base>
