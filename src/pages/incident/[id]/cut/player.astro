---
// The cutscene player as a bare HTML fragment, for the homepage to fetch and mount when the reader presses play.
// It carries its own styles (a partial has no head, so the kit's stylesheet goes in as text); the page that
// fetches it imports the engine (src/scripts/anime.ts) and calls mountCutscene on the section.
export const partial = true;
import { getCollection } from 'astro:content';
import Cutscene from '../../../../components/anime/Cutscene.astro';
import { shotList } from '../../../../lib/cuts';
import type { Incident } from '../../../../lib/site';
import css from '../../../../styles/cut.css?raw';

export async function getStaticPaths() {
    const all = await getCollection('incidents');
    return all.filter((i) => shotList(i.id)).map((incident) => ({ params: { id: incident.id }, props: { incident } }));
}
interface Props { incident: Incident }
const { incident } = Astro.props;
const d = incident.data;
const list = shotList(incident.id)!;
---
<style set:html={css}></style>
<section class="cut-wrap" id="cutscene" aria-label={`${d.title}, as an anime cutscene`} data-base={import.meta.env.BASE_URL}>
    <Cutscene list={list} status={d.status} frame="16:9" />
    <template data-frame="9:16"><Cutscene list={list} status={d.status} frame="9:16" /></template>
    <p class="cut-hint" data-hint aria-hidden="true">Tap, click or press space</p>
    <p class="cut-count" data-count aria-hidden="true"></p>
    <button type="button" class="cut-skip" data-skip>Skip to the end</button>
    <button type="button" class="cut-sound" data-sound aria-pressed="true" hidden>Sound on</button>
</section>
