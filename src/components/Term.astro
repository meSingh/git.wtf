---
// The terminal card: the retelling of one incident, the stamped status, the meta line.
// `typed` splits the body into sentences and characters for the scroll-typed beat on the homepage.
import { render } from 'astro:content';
import { categoryLabel, formatDate, href, incidentPath, inlineCode, sentences, sourceHost, type Incident } from '../lib/site';

interface Props {
    incident: Incident;
    typed?: boolean;
    linkTitle?: boolean;
    id?: string;
}
const { incident, typed = false, linkTitle = false, id } = Astro.props;
const d = incident.data;
const path = incidentPath(incident);
const sents = sentences(incident.body ?? '');
const { Content } = await render(incident);
---
<article class="term" id={id} data-incident={incident.id}>
    <div class="term-bar" aria-hidden="true">
        <span class="lights"><i></i><i></i><i></i></span>
        <span class="path">incidents/{incident.id}.md</span>
    </div>
    <div class="term-body">
        <h2 class="term-title">{linkTitle ? <a href={href(path)}>{d.title}</a> : d.title}</h2>
        {typed ? (
            <>
                <p class="visually-hidden">{sents.join(' ')}</p>
                <div class="typed" aria-hidden="true">
                    {sents.map((s, si) => (
                        <>
                            <span class="sent" data-i={si}>{[...s].map((ch) => <span class="ch">{ch}</span>)}</span>
                            {si < sents.length - 1 && ' '}
                        </>
                    ))}
                </div>
            </>
        ) : (
            <div class="typed static"><Content /></div>
        )}
        <div class="stamp-row">
            <span class="stamp" set:html={`<span class="lbl">Status</span>${inlineCode(d.status)}`} />
        </div>
        <p class="term-meta">
            <time datetime={d.source_date}>{formatDate(d.source_date)}</time>
            <a class="chip" href={href(`/incidents/${d.category}/`)}>{categoryLabel(d.category)}</a>
            <a class="src" href={d.source_url} rel="noopener nofollow">Source: {sourceHost(d.source_url)}</a>
        </p>
    </div>
</article>
