---
// The mark. A placeholder until the new wordmark (from the 2023 GIT.WTF!?! mark) is picked: the final one replaces
// this file and nothing else changes. `height` is the cap height of the lettering.
interface Props { height?: string; class?: string; title?: string }
const { height = '1.6rem', class: cls = '', title = 'GIT.WTF!?!' } = Astro.props;
---
<span class={`logo ${cls}`.trim()} style={`--logo-h:${height}`} role="img" aria-label={title}><span aria-hidden="true">GIT.WTF<b>!?!</b></span></span>
