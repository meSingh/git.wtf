---
// The git.wtf wordmark (concept A, the hazard bar): GIT.WTF!?! in Big Shoulders Display 900, outlined, with a short
// hazard-stripe bar above the G. The files come from scripts/make-logo.mjs: public/logo.svg (full colour) and
// public/logo-black.svg (one colour, for yellow grounds). Served as an image, not inlined, so the outlines stay out
// of the HTML and off the first paint. `height` is the whole mark's height.
import { LOGO } from '../lib/logo-data';
import { href } from '../lib/site';
interface Props { height?: string; class?: string; title?: string; mono?: boolean }
const { height = '1.75rem', class: cls = '', title = 'git.wtf', mono = false } = Astro.props;
const h = 30;
const w = Math.round((h * LOGO.width) / LOGO.height);
---
<img class={`logo ${cls}`.trim()} src={href(mono ? '/logo-black.svg' : '/logo.svg')} alt={title} width={w} height={h} style={`height:${height}`} decoding="async" />
