---
// The record: every published incident, newest first, going back in time. Each card opens its incident; between
// cards, the real gap in days. One incident is a single card with a note; many make a column with gap marks.
import Odo from './Odo.astro';
import { cutAssets } from '../lib/cuts';
import { categoryLabel, daysBetween, formatDate, happened, href, incidentPath, inlineCode, sortIncidents, type Incident } from '../lib/site';

interface Props { incidents: Incident[] }
const { incidents } = Astro.props;
const list = sortIncidents(incidents); // newest first
const QUIET = 21;
const pic = (i: Incident) => {
    const c = cutAssets(i.id);
    return c.poster ? { src: href(`/cuts/${i.id}/${c.poster}`), w: 1280, h: 720 } : { src: href(`/strips/${i.id}/p4-800.webp`), w: 800, h: 447 };
};
const gapFrom = (g: number) => (g < 10 ? 9 : Math.min(99, g + 30));
---
<div class="record col">
    <div class="beat-head"><h2 id="record-h" data-lock>The record</h2><span class="count">Newest first, going back in time.</span></div>
    <ol class="rlist">
        {list.map((i, n) => {
            const p = pic(i);
            const gap = n < list.length - 1 ? daysBetween(happened(list[n + 1]), happened(i)) : null;
            return (
                <li class="ritem">
                    <a class="rcard" href={href(incidentPath(i))}>
                        <img class="rpic" src={p.src} width={p.w} height={p.h} alt="" loading="lazy" decoding="async" />
                        <span class="rtext">
                            <span class="rmeta"><time datetime={happened(i)}>{formatDate(happened(i))}</time><span class="rcat">{categoryLabel(i.data.category)}</span></span>
                            <span class="rtitle">{i.data.title}</span>
                            <span class="rstatus" set:html={`Status: ${inlineCode(i.data.status)}`} />
                            <span class="rgo">{cutAssets(i.id).poster ? 'Watch it' : 'Read it'} <span aria-hidden="true">&rarr;</span></span>
                        </span>
                    </a>
                    {gap !== null && (
                        <p class={`rgap${gap >= QUIET ? ' quiet' : ''}`} aria-label={`${gap} days earlier`}>
                            {gap === 0 ? <span class="rgap-w">the same day</span> : <><Odo value={gap} from={gapFrom(gap)} dimLead={false} class="gap-odo" label={`${gap}`} /><span class="rgap-w">{gap === 1 ? 'day earlier' : gap >= QUIET ? 'quiet days earlier' : 'days earlier'}</span></>}
                        </p>
                    )}
                </li>
            );
        })}
    </ol>
    {list.length === 1 ? (
        <p class="rfoot">Just one so far. It won't be lonely for long.</p>
    ) : (
        <p class="rfoot"><a href={href('/incidents/')}>Every incident, by category <span aria-hidden="true">&rarr;</span></a></p>
    )}
</div>
