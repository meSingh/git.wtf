---
import { confessionCount, confessIssueUrl, confessMailto } from '../lib/confessions';
const n = await confessionCount();
// the description is a PLACEHOLDER until Content's lands; the image slot waits for Video's (1200 by 630)
---
<div class="confess col">
    <div class="beat-head"><h2 id="confess-h" data-lock>Confess</h2>{n !== null && <span class="count">{n} received so far</span>}</div>
    <div class="confess-in">
        <div class="confess-text">
            <p class="ask">Have a fuck-up? Confess it.</p>
            <p class="desc" data-confess-desc>Yours, a colleague's, an agent's. Tell the daily search what ran and what it broke, and it goes on the record with the rest.</p>
            <p class="ways">
                <a class="big" href={confessIssueUrl} rel="noopener">Open a confession on GitHub</a>
                {confessMailto && <a class="mail" href={confessMailto}>or send it to the daily search</a>}
            </p>
            <p class="how">What you ran, what happened, a link if there is one.</p>
        </div>
        <figure class="confess-pic" data-confess-pic>
            <div class="confess-slot" role="img" aria-label="Image to come">1200 &times; 630</div>
        </figure>
    </div>
</div>
