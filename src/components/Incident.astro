---
import { existsSync } from 'node:fs';
import path from 'node:path';
import { render } from 'astro:content';
import { formatDate, incidentPath, inlineCode, sourceHost, type Incident } from '../lib/site';

interface Props {
    incident: Incident;
    /** Link the title to the incident page (homepage) or not (the page itself). */
    linked?: boolean;
    /** Show the share image under the text (the incident page). */
    showShare?: boolean;
}
const { incident, linked = false, showShare = false } = Astro.props;
const { Content } = await render(incident);
const d = incident.data;
const href = incidentPath(incident);
// A local render (scripts/render-video.mjs --local) shows up on preview builds without touching the front matter.
const localVideo = existsSync(path.join(process.cwd(), 'public/incident', incident.id, 'video.mp4'));
const video = d.video ?? (localVideo ? `${href}video.mp4` : null);
const poster = d.poster ?? (localVideo && existsSync(path.join(process.cwd(), 'public/incident', incident.id, 'poster.jpg')) ? `${href}poster.jpg` : `${href}share.png`);
---
<article class="incident">
    {linked ? <h2><a href={href}>{d.title}</a></h2> : <h1>{d.title}</h1>}
    <p class="meta">
        <time datetime={d.date}>{formatDate(d.date)}</time>
        <span class="cat">{d.category}</span>
    </p>
    <div class="body"><Content /></div>
    <p class="status" set:html={`Status: ${inlineCode(d.status)}`} />
    <p class="source">Source: <a href={d.source_url} rel="noopener nofollow">{sourceHost(d.source_url)}</a>, {formatDate(d.source_date)}.</p>
    {showShare && video && (
        <p class="video"><video src={video} poster={poster} controls muted playsinline preload="none" width="1080" height="1920">Your browser does not play this video. <a href={video}>Download it.</a></video></p>
    )}
    {showShare && (
        <p class="share"><img src={`${href}share.png`} alt={`Share image: ${d.title}`} width="1200" height="630" loading="lazy" /></p>
    )}
</article>
