---
// The score, the page's centrepiece: humans against AI, nothing finer than that, under the tagline. The streak
// (days since the last, the longest quiet stretch, the average gap) sits on the same board as its small print.
import Odo from './Odo.astro';
import { SITE, daysBetween, formatDay, happened, sortIncidents, todayIST, type Incident } from '../lib/site';
interface Props { incidents: Incident[] }
const { incidents } = Astro.props;
const by = (actor: string) => incidents.filter((i) => i.data.actor === actor).length;
const humans = by('human');
const ai = by('ai');
const github = by('github');
const days = [...new Set(sortIncidents(incidents).map(happened))].sort();
const today = todayIST();
const current = days.length ? Math.max(0, daysBetween(days[days.length - 1], today)) : 0;
let best = { n: 0, from: '', to: '' };
for (let i = 1; i < days.length; i++) {
    const n = daysBetween(days[i - 1], days[i]);
    if (n > best.n) best = { n, from: days[i - 1], to: days[i] };
}
const currentIsBest = current > best.n;
const avg = days.length > 1 ? daysBetween(days[0], days[days.length - 1]) / (days.length - 1) : null;
const year = (iso: string) => iso.slice(0, 4);
// PLACEHOLDER copy around the board until Content's lands (notes/content/homepage-v5-copy.md)
---
<div class="score col">
    <p class="score-kicker">The score</p>
    <h2 id="score-h" class="score-title" data-lock>{SITE.description}</h2>
    <div class="board" role="group" aria-label={`Humans ${humans}, AI ${ai}`}>
        <div class="team">
            <Odo value={humans} from={0} min={2} class="score-odo wheel" label={`${humans} caused by humans`} />
            <span class="who">Humans</span>
        </div>
        <span class="vs" aria-hidden="true">v</span>
        <div class="team ai">
            <Odo value={ai} from={0} min={2} class="score-odo wheel" label={`${ai} caused by AI`} />
            <span class="who">AI</span>
        </div>
    </div>
    <dl class="run">
        <div><dt>Days since the last one</dt><dd><Odo value={current} from={0} min={2} since={days[days.length - 1] ?? null} class="run-odo wheel" label={`${current}`} /></dd></div>
        <div><dt>{currentIsBest || best.n === 0 ? 'Longest quiet stretch' : `Longest quiet stretch, ${formatDay(best.from)} to ${formatDay(best.to)}`}</dt><dd><Odo value={currentIsBest || best.n === 0 ? current : best.n} from={0} min={2} class="run-odo wheel" label={`${currentIsBest || best.n === 0 ? current : best.n} days`} />{(currentIsBest || best.n === 0) && <span class="run-note">this one, still going</span>}</dd></div>
        <div><dt>Days between fuck-ups, on average</dt><dd>{avg === null ? <span class="run-na">one so far</span> : <Odo value={Math.round(avg)} from={0} min={2} class="run-odo wheel" label={`${avg.toFixed(1)} days`} />}</dd></div>
    </dl>
    <p class="score-foot">{incidents.length === 1 ? 'One' : incidents.length} on record since {days[0] ? `${formatDay(days[0])} ${year(days[0])}` : 'the start'}.{github > 0 && ` GitHub itself: ${github}.`}</p>
</div>
