---
import { CATEGORIES } from '../content.config';
import { categoryLabel, href, type Incident } from '../lib/site';
interface Props { incidents: Incident[] }
const { incidents } = Astro.props;
const counts = Object.fromEntries(CATEGORIES.map((c) => [c, incidents.filter((i) => i.data.category === c).length]));
---
<div class="tally">
    {CATEGORIES.map((c) => (
        <a href={href(`/incidents/${c}/`)}>
            <span class={`n${counts[c] === 0 ? ' zero' : ''}`} data-n={counts[c]}>{counts[c]}</span>
            <span class="l">{categoryLabel(c)}</span>
        </a>
    ))}
</div>
