---
// The homepage's cut: its title-card poster and a play button. On the press, src/scripts/home.ts fetches the
// player fragment (/incident/<id>/cut/player/) into this box and mounts the engine, so the page's first paint
// carries none of the cutscene.
import { href, incidentPath, type Incident } from '../lib/site';
interface Props { incident: Incident; poster: string; posterTall: string | null }
const { incident, poster, posterTall } = Astro.props;
const p = incidentPath(incident);
---
<div class="col today-cut" data-player={href(`${p}cut/player/`)}>
    <picture class="today-poster">
        {posterTall && <source media="(max-width: 639px)" srcset={posterTall} width="720" height="1280" />}
        <img src={poster} width="1280" height="720" alt={`The cut: ${incident.data.title}`} decoding="async" loading="lazy" />
    </picture>
    <button type="button" class="today-play" data-play><span class="tri" aria-hidden="true"></span>Play the cut</button>
    <noscript><a class="today-play" href={href(`${p}cut/`)}>Play the cut</a></noscript>
</div>
