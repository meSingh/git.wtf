---
// The anime cutscene: every shot of a shot list drawn in its own group, one shown at a time by
// src/scripts/anime.ts. Two frames: 16:9 (1600 x 900, the website and link posts) and 9:16 (900 x 1600, the
// phone, Reels, Shorts and TikTok first). The vertical frame is staged, not cropped: a shot's `v` block places its
// cast and props for the tall frame; without one, a layout rule does (compress to the middle, stand faces in the
// safe area). Words, lines, the title card, the end card and the stamp always sit inside the vertical safe area
// agreed with Video: x 54 to 740, y 240 to 1040.
import type { CastIn, Shot, ShotList } from '../../anime/types';
import Dev from './Dev.astro';
import Agent from './Agent.astro';
interface Props { list: ShotList; status: string; frame?: '16:9' | '9:16' }
const { list, status, frame = '16:9' } = Astro.props;
const V = frame === '9:16';
const W = V ? 900 : 1600, H = V ? 1600 : 900;
const CX = W / 2, CY = H / 2;
const SAFE = { x0: 54, x1: 740, y0: 240, y1: 1040 };
const safeW = SAFE.x1 - SAFE.x0, safeX = (SAFE.x0 + SAFE.x1) / 2;

const st = status.replace(/`/g, '');
const cut = st.length > 24 ? st.indexOf(',') : -1;
const stamp = cut > 0 ? [st.slice(0, cut + 1), st.slice(cut + 1).trim()] : [st];

// the vertical layout rule, used where a shot has no `v` placement
const mx = (x: number) => (V ? Math.round(450 + (x - 800) * 0.55) : x);
// the ground moves up from 900 to 1120, so busts stand with their faces inside the safe area
const DY = 220;
const my = (y: number) => (V ? y + DY : y);
const ms = (s = 1) => (V ? +(s * 0.82).toFixed(3) : s);
const castOf = (s: Shot): CastIn[] => (V && s.v?.cast ? s.v.cast : (s.cast ?? []).map((c) => (V ? { ...c, x: mx(c.x), y: my(c.y), scale: ms(c.scale) } : c)));
type P = { x: number; y: number; scale?: number; to?: [number, number] };
const propOf = <K extends string>(s: Shot, k: K): P | undefined => {
    const own = (V ? (s.v?.props as Record<string, P> | undefined)?.[k] : undefined) ?? (s.props as Record<string, P> | undefined)?.[k];
    if (!own || typeof own !== 'object') return undefined;
    if (!V || (s.v?.props as Record<string, P> | undefined)?.[k]) return own;
    return { ...own, x: mx(own.x), y: my(own.y), scale: ms(own.scale), to: own.to ? [mx(own.to[0]), my(own.to[1])] : undefined };
};

// concentration lines: thin wedges from the frame's middle out
const wedges = Array.from({ length: 72 }, (_, i) => {
    const a = (i / 72) * Math.PI * 2 + (i % 3) * 0.01;
    const w = 0.012 + (i % 5) * 0.004;
    const r0 = 260 + (i % 4) * 60, r1 = 2000;
    const p = (r: number, d: number) => `${(CX + Math.cos(a + d) * r).toFixed(0)} ${(CY + Math.sin(a + d) * r).toFixed(0)}`;
    return `M${p(r0, 0)} L${p(r1, -w)} L${p(r1, w)}Z`;
});
const files = Array.from({ length: 40 }, (_, i) => i);
const rainLines = Array.from({ length: 110 }, (_, i) => { const x = (i * 211) % 2400 - 400, y = (i * 137) % 2000 - 300; return `M${x} ${y} l-14 70`; });
// twelve slivers: columns across the wide frame, slanted rows down the tall one
const slivers = Array.from({ length: 12 }, (_, k) => {
    if (!V) {
        const w = 1600 / 12, x0 = k * w - 90, x1 = (k + 1) * w - 90;
        return { ax: (x0 + x1) / 2 + 60, ay: 560 + (k % 3) * 60, s: 0.5, clip: `M${x0} -400 L${x1} -400 L${x1 + 180} 1300 L${x0 + 180} 1300Z`, edge: `M${x1} -400 L${x1 + 180} 1300` };
    }
    const h = 1600 / 12, y0 = k * h - 60, y1 = (k + 1) * h - 60;
    return { ax: 180 + (k % 3) * 250, ay: y1 + 70, s: 0.26, clip: `M-400 ${y0 + 120} L1400 ${y0} L1400 ${y1} L-400 ${y1 + 120}Z`, edge: `M-400 ${y1 + 120} L1400 ${y1}` };
});
// three diagonal panels: bands across the wide frame, stacked down the tall one
const panels = V
    ? { paths: ['M-400 -400 L1400 -400 L1400 420 L-400 560Z', 'M-400 600 L1400 460 L1400 1020 L-400 1160Z', 'M-400 1200 L1400 1060 L1400 2200 L-400 2200Z'], centre: [[450, 330], [450, 820], [450, 1360]], scale: 1, gutters: 'M-400 580 L1400 440 M-400 1180 L1400 1040' }
    : { paths: ['M-400 -200 L2000 -200 L2000 170 L-400 330Z', 'M-400 350 L2000 190 L2000 520 L-400 680Z', 'M-400 700 L2000 540 L2000 1100 L-400 1100Z'], centre: [[560, 120], [1040, 440], [640, 770]], scale: 1, gutters: 'M-400 340 L2000 180 M-400 690 L2000 530' };
const dy = V ? DY : 0;
// where words, lines and cards sit, and how they shrink to fit the vertical safe width
const fitK = (len: number, per: number) => (V ? Math.min(1, safeW / (len * per)) : 1);
const word = V ? { x: safeX, y: 340, rot: -6 } : { x: 800, y: 200, rot: -7 };
const line = V ? { x: safeX, y: 990 } : { x: 800, y: 830 };
const title = V ? { band: 600, ep: 570, ttl: 760 } : { band: 330, ep: 300, ttl: 490 };
const stampAt = V ? { x: safeX, y: 760, k: Math.min(1, safeW / 980) } : { x: 800, y: 650, k: 1 };
const tbc = V ? { x: SAFE.x0 + 6, y: 960, k: 0.75 } : { x: 120, y: 840, k: 1 };
---
<svg class="cutscene" data-frame={frame} data-centre={`${CX} ${CY}`} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" role="img" aria-label={`${list.episode}: ${list.title}. An anime cutscene. Status: ${st}`} data-list={JSON.stringify(list)}>
    <defs>
        <pattern id="a-hazard" width="24" height="24" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="12" height="24" fill="#ffd400" /><rect x="12" width="12" height="24" fill="#0a0a0a" /></pattern>
        <filter id="a-glow" x="-50%" y="-200%" width="200%" height="500%"><feGaussianBlur stdDeviation="9" result="b" /><feMerge><feMergeNode in="b" /><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
        {panels.paths.map((d, i) => <clipPath id={`a-panel-${i}`}><path d={d} /></clipPath>)}
        {slivers.map((sv, k) => <clipPath id={`a-sliver-${k}`}><path d={sv.clip} /></clipPath>)}
    </defs>
    <rect class="ground" x="-2000" y="-2000" width="5600" height="6000" />
    {list.shots.map((s, si) => {
        const folder = propOf(s, 'folder'), desk = propOf(s, 'desk'), copier = propOf(s, 'copier'), branch = propOf(s, 'branch');
        const paper = propOf(s, 'paper'), stack = propOf(s, 'stack'), counter = propOf(s, 'counter');
        const focus = V ? [CX, CY] : s.focus ?? [800, 450];
        return (
            <g class={`shot bg-${s.bg ?? 'black'}`} data-shot={s.id} data-i={si} data-focus={focus.join(' ')} style="visibility:hidden">
                <rect class="bg" x="-2000" y="-2000" width="5600" height="6000" />
                {s.bg === 'speedlines' && <g class="lines">{wedges.map((d) => <path d={d} />)}</g>}
                {s.bg === 'dusk' && <g class="dusk"><rect class="sky" x="-2000" y="-2000" width="5600" height={2440 + dy} /><rect class="glow" x="-2000" y={440 + dy} width="5600" height="170" /><rect class="sun" x="-2000" y={560 + dy} width="5600" height="50" /><rect class="land" x="-2000" y={600 + dy} width="5600" height="3000" /></g>}
                {s.props?.rain && <g class="rain">{rainLines.map((d) => <path d={d} />)}</g>}
                <g class="cam">
                    {s.bg === 'split' && (s.panels ?? []).map((c, i) => (
                        <g class="panel" clip-path={`url(#a-panel-${i})`}>
                            <rect class="pbg" x="-400" y="-400" width="2400" height="2800" />
                            <g class="plines" transform={`translate(${panels.centre[i][0] - CX} ${panels.centre[i][1] - CY})`}>{wedges.map((d) => <path d={d} />)}</g>
                            <g transform={`translate(${panels.centre[i][0]} ${panels.centre[i][1] + 404}) scale(${i === 1 ? -1 : 1} 1)`}><Agent pose={c.pose} n={c.n} head /></g>
                        </g>
                    ))}
                    {s.bg === 'split' && <path class="gutters" d={panels.gutters} />}
                    {s.bg === 'split12' && (
                        <g class="slivers">
                            {slivers.map((sv, k) => (
                                <g class="sliver" clip-path={`url(#a-sliver-${k})`}>
                                    <rect class={`sbg sbg-${k % 3}`} x="-1200" y="-1200" width="4000" height="4400" />
                                    <g transform={`translate(${sv.ax} ${sv.ay}) scale(${sv.s})`}><Agent pose="dramatic" n={k + 1} arm="point" /></g>
                                </g>
                            ))}
                            <g class="sgutters">{slivers.map((sv) => <path d={sv.edge} />)}</g>
                        </g>
                    )}
                    {s.fx?.includes('door') && <g class="doorframe" transform={V ? `translate(-350 ${DY})` : undefined}><rect class="dark" x="560" y="140" width="480" height="780" /><path class="jamb" d="M540 940 L540 120 L1060 120 L1060 940" /></g>}
                    {desk && <g class="desk" transform={`translate(${desk.x} ${desk.y}) scale(${desk.scale ?? 1})`}><rect x="-200" y="-30" width="400" height="34" rx="4" /><rect x="-180" y="4" width="18" height="140" /><rect x="162" y="4" width="18" height="140" /></g>}
                    {copier && <g class="copier" transform={`translate(${copier.x} ${copier.y}) scale(${copier.scale ?? 1})`}><rect class="box" x="-70" y="-150" width="140" height="150" rx="8" /><rect class="lid" x="-78" y="-168" width="156" height="22" rx="4" /><rect class="beam" x="-60" y="-140" width="120" height="10" /></g>}
                    {branch && <g class="branch" transform={`translate(${branch.x} ${branch.y}) scale(${branch.scale ?? 1})`} filter="url(#a-glow)"><path class="half a" d="M-20 300 L-6 0 L14 0 L4 300Z" /><path class="half b" d="M-6 0 L-10 -290 L10 -290 L14 0Z" /><path class="twig" d="M2 -150 L60 -210 M0 -60 L-50 -120" /></g>}
                    {folder && (
                        <g class="folder" transform={`translate(${folder.x} ${folder.y}) scale(${folder.scale ?? 1})`}>
                            <path class="tab" d="M-180 -150 L-60 -150 L-30 -118 L180 -118 L180 -96 L-180 -96Z" />
                            <rect class="body" x="-190" y="-110" width="380" height="250" rx="16" />
                            <text x="0" y="40">my folder</text>
                        </g>
                    )}
                    {s.props?.files && (
                        <g class="files" data-from={folder ? `${folder.x} ${folder.y - 60 * (folder.scale ?? 1)}` : `${CX} ${CY}`}>
                            {files.map(() => <g class="file" style="visibility:hidden"><rect x="-26" y="-34" width="52" height="68" rx="4" /><path d="M-14 -16 h28 M-14 -4 h28 M-14 8 h18" /></g>)}
                        </g>
                    )}
                    {paper && <g class="paper1" transform={`translate(${paper.x} ${paper.y})`}><g class="p-in"><rect x="-30" y="-38" width="60" height="76" rx="4" /><path d="M-16 -18 h32 M-16 -4 h32 M-16 10 h22" /></g></g>}
                    {stack && <g class="stack" transform={`translate(${stack.x} ${stack.y}) scale(${stack.scale ?? 1})`} data-to={stack.to?.join(' ')}><g class="s-in">{[0, 1, 2, 3, 4, 5, 6, 7].map((k) => <rect x={-90 + (k % 2) * 6} y={-24 - k * 22} width="180" height="22" rx="3" />)}</g></g>}
                    {castOf(s).map((c) => (
                        <g transform={`translate(${c.x} ${c.y}) scale(${(c.flip ? -1 : 1) * (c.scale ?? 1)} ${c.scale ?? 1})`}>
                            <g class="fig" data-who={c.who} data-role={c.role}>{c.who === 'dev' ? <Dev pose={c.pose} arm={c.arm} /> : <Agent pose={c.pose} n={c.n} extra={c.extra} silhouette={c.silhouette} arm={c.arm} turn={c.turn} />}</g>
                        </g>
                    ))}
                    {counter && <text class="counter" x={V ? safeX : counter.x} y={V ? 520 : counter.y} data-to={s.props!.counter!.to}>0</text>}
                </g>
                {s.word && <g class="word" data-len={s.word.length} data-at={s.wordAt}><g class="wordfit" transform={V ? `translate(${word.x} ${word.y}) scale(${fitK(s.word.length, 98).toFixed(3)}) translate(${-word.x} ${-word.y})` : undefined}><text x={word.x} y={word.y} transform={`rotate(${word.rot} ${word.x} ${word.y})`}>{s.word}</text></g></g>}
                {s.line && (
                    <g class="line" data-at={s.lineAt} data-len={s.line.who.length + s.line.text.length + 2} transform={V ? `translate(${line.x} ${line.y}) scale(${fitK(s.line.who.length + s.line.text.length + 2, 24).toFixed(3)}) translate(${-line.x} ${-line.y})` : undefined}>
                        <text x={line.x} y={line.y}><tspan class="who">{s.line.who}</tspan><tspan dx="18">{s.line.text}</tspan></text>
                    </g>
                )}
                {s.fx?.includes('titlecard') && (
                    <g class="titlecard">
                        <g class="lines tl">{wedges.map((d) => <path d={d} />)}</g>
                        <rect class="band" x="-2000" y={title.band} width="5600" height="250" />
                        <text class="ep" x={V ? safeX : 800} y={title.ep}>{list.episode}</text>
                        <g class="ttlfit" transform={V ? `translate(${safeX} ${title.ttl}) scale(${fitK(list.title.length, 62).toFixed(3)}) translate(${-safeX} ${-title.ttl})` : undefined}><text class="ttl" x={V ? safeX : 800} y={title.ttl}>{list.title}</text></g>
                    </g>
                )}
                {s.fx?.includes('endcard') && (
                    <g class="endcard">
                        <g class="tbc" transform={`translate(${tbc.x} ${tbc.y}) scale(${tbc.k})`}><g class="tbc-in">
                            <path d="M0 -40 L420 -40 L420 -62 L486 0 L420 62 L420 40 L0 40Z" />
                            <text x="200" y="14">To be continued</text>
                        </g></g>
                        <g class="stampspot" transform={`translate(${stampAt.x} ${stampAt.y}) rotate(-5)`}><g class="stampfit" transform={stampAt.k < 1 ? `scale(${stampAt.k.toFixed(3)})` : undefined}><g class="stampmark">
                            <rect class="plate" x="-480" y="-110" width="960" height={stamp.length > 1 ? 220 : 140} rx="6" />
                            <rect class="inner" x="-462" y="-94" width="924" height={stamp.length > 1 ? 188 : 108} rx="4" />
                            <text class="slbl" x="-436" y="-54">STATUS</text>
                            {stamp.map((t, i) => <text class="stext" x="0" y={stamp.length > 1 ? 16 + i * 78 : 22}>{t}</text>)}
                        </g></g></g>
                    </g>
                )}
            </g>
        );
    })}
    <rect class="flash" x="-2000" y="-2000" width="5600" height="6000" style="visibility:hidden" />
</svg>
