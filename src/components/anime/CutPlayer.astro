---
// The cutscene player: the frame, its controls (hint, counter, skip, sound) and the engine. Used by every cut page.
import '../../styles/cut.css';
import Cutscene from './Cutscene.astro';
import type { ShotList } from '../../anime/types';
interface Props { list: ShotList; status: string; title: string }
const { list, status, title } = Astro.props;
---
<section class="cut-wrap" id="cutscene" aria-label={`${title}, as an anime cutscene`} data-base={import.meta.env.BASE_URL}>
    <Cutscene list={list} status={status} />
    <p class="cut-hint" data-hint aria-hidden="true">Click, tap or press space</p>
    <p class="cut-count" data-count aria-hidden="true"></p>
    <button type="button" class="cut-skip" data-skip>Skip to the end</button>
    <button type="button" class="cut-sound" data-sound aria-pressed="true" hidden>Sound on</button>
</section>
<script>
    import { mountCutscene } from '../../scripts/anime';
    const wrap = document.querySelector<HTMLElement>('#cutscene');
    if (wrap) mountCutscene(wrap);
</script>
