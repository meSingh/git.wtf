---
// The git.wtf developer, from format D: a big round off-white head, half-lidded eyes with small pupils looking
// down, a flat little mouth; a black hoodie drawn in grey ink, with shoulders, a hood, drawstrings and a kangaroo
// pocket; sleeves that bend at the elbow; black trousers; a white mug. Full figure, origin at his feet.
// Poses: neutral (the deadpan stare), sip, shock (his work is gone), relief, stack (holding the saved stack).
// Drawn to read at phone size: heavy ink, few small details.
export type MascotPose = 'neutral' | 'sip' | 'shock' | 'relief' | 'stack';
interface Props { pose?: MascotPose; shadow?: boolean }
const { pose = 'neutral', shadow = true } = Astro.props;
const EX = 58, EY = -566;
// a sleeve: shoulder, elbow, wrist, as one bent stroke (grey ink under black cloth)
const sleeve = (pts: [number, number][]) => 'M' + pts.map(([x, y]) => `${x} ${y}`).join(' L');
// shoulders drop a little when he breathes out
const sh = pose === 'relief' ? 14 : 0;
const L = { s: [-112, -380 + sh] as [number, number] }, R = { s: [112, -380 + sh] as [number, number] };
const arms: Record<MascotPose, { l: [number, number][]; r: [number, number][]; front?: boolean }> = {
    neutral: { l: [L.s, [-156, -290], [-70, -262]], r: [R.s, [150, -282], [134, -200]] },
    sip: { l: [L.s, [-150, -286], [-46, -404]], r: [R.s, [150, -282], [134, -200]], front: true },
    shock: { l: [L.s, [-206, -430], [-190, -560]], r: [R.s, [206, -430], [190, -560]] },
    relief: { l: [L.s, [-154, -278], [-70, -248]], r: [R.s, [148, -268], [134, -186]] },
    stack: { l: [L.s, [-160, -290], [-104, -214]], r: [R.s, [160, -290], [104, -214]] },
};
const a = arms[pose];
const mug = (x: number, y: number, rot = 0) => ({ x, y, rot });
const mugAt = pose === 'neutral' ? mug(-30, -296) : pose === 'relief' ? mug(-30, -282) : pose === 'sip' ? mug(-14, -458, -24) : null;
---
<g class={`mascot m-${pose}`}>
    {shadow && <ellipse class="m-shadow" cx="0" cy="4" rx="150" ry="22" />}
    <g class="m-body" transform={pose === 'shock' ? 'rotate(-4 0 0)' : undefined}>
        <!-- trousers and shoes -->
        <path class="m-pants" d="M-80 -176 L-76 -16 L-14 -16 L-8 -148 L8 -148 L14 -16 L76 -16 L80 -176Z" />
        <path class="m-shoe" d="M-86 -20 C-86 -6 -68 0 -46 0 L-10 0 C-6 -10 -12 -20 -24 -22Z" />
        <path class="m-shoe" d="M86 -20 C86 -6 68 0 46 0 L10 0 C6 -10 12 -20 24 -22Z" />
        <!-- the hoodie: hood behind the neck, shoulders, a hem, the kangaroo pocket, the drawstrings -->
        <path class="m-hood" d={`M-104 ${-386 + sh} C-122 -440 -70 -474 0 -474 C70 -474 122 -440 104 ${-386 + sh}`} />
        <path class="m-hoodie" d={`M-116 ${-390 + sh} C-140 ${-380 + sh} -150 ${-350 + sh} -148 -300 L-140 -186 C-138 -170 -124 -162 -108 -162 L108 -162 C124 -162 138 -170 140 -186 L148 -300 C150 ${-350 + sh} 140 ${-380 + sh} 116 ${-390 + sh} C84 ${-408 + sh} -84 ${-408 + sh} -116 ${-390 + sh}Z`} />
        <path class="m-hem" d="M-138 -184 L138 -184" />
        <path class="m-pocket" d="M-74 -270 L74 -270 L96 -192 M-74 -270 L-96 -192 M-96 -192 L96 -192" />
        <path class="m-neck" d={`M-30 ${-402 + sh} L0 ${-374 + sh} L30 ${-402 + sh}Z`} />
        <path class="m-string" d={`M-22 ${-390 + sh} L-28 ${-318 + sh} M22 ${-390 + sh} L28 ${-318 + sh}`} />
        <circle class="m-tip" cx="-28" cy={-312 + sh} r="6" /><circle class="m-tip" cx="28" cy={-312 + sh} r="6" />

        {pose === 'stack' && (
            <g class="m-stack">{[0, 1, 2, 3, 4, 5].map((k) => <path class="m-sheet" d={`M${-100 + (k % 2) * 8} ${-210 - k * 28} L${100 + (k % 2) * 8} ${-210 - k * 28} L${106 + (k % 2) * 8} ${-186 - k * 28} L${-94 + (k % 2) * 8} ${-186 - k * 28}Z`} />)}</g>
        )}

        <!-- sleeves: the right one, and the left one unless it is in front of the face -->
        <path class="m-sleeve-o" d={sleeve(a.r)} /><path class="m-sleeve" d={sleeve(a.r)} />
        <circle class="m-hand" cx={a.r[2][0]} cy={a.r[2][1]} r="22" />
        {!a.front && <><path class="m-sleeve-o" d={sleeve(a.l)} /><path class="m-sleeve" d={sleeve(a.l)} /></>}
        {mugAt && !a.front && (
            <g class="m-mug" transform={`translate(${mugAt.x} ${mugAt.y}) rotate(${mugAt.rot})`}><path class="m-cup" d="M-32 -38 L38 -38 L34 36 L-28 36Z" /><path class="m-handle" d="M38 -18 C64 -18 64 20 36 20" /><ellipse class="m-coffee" cx="3" cy="-38" rx="35" ry="8" /></g>
        )}
        {!a.front && pose !== 'shock' && <circle class="m-hand" cx={a.l[2][0]} cy={a.l[2][1]} r="22" />}
        {pose === 'shock' && <circle class="m-hand" cx={a.l[2][0]} cy={a.l[2][1]} r="22" />}
        {pose === 'shock' && (
            <>
                <g class="m-mug" transform="translate(-150 -112) rotate(-118)"><path class="m-cup" d="M-32 -38 L38 -38 L34 36 L-28 36Z" /><path class="m-handle" d="M38 -18 C64 -18 64 20 36 20" /></g>
                <path class="m-spill" d="M-196 -58 C-238 -38 -256 -8 -214 0 C-182 6 -150 -8 -160 -34Z" />
            </>
        )}

        <!-- the head -->
        <circle class="m-head" cx="0" cy={-560 + sh} r="152" />
        <g transform={sh ? `translate(0 ${sh})` : undefined}>
            {(pose === 'neutral' || pose === 'stack') && (
                <>
                    {[-EX, EX].map((x) => <g class="m-eye"><circle class="m-white" cx={x} cy={EY} r="32" /><path class="m-pupil" d={`M${x - 10} ${EY - 4} a13 13 0 0 0 26 0Z`} /><path class="m-lid" d={`M${x - 32} ${EY - 4} L${x + 32} ${EY - 4}`} /></g>)}
                    <path class="m-mouth" d="M-16 -486 L12 -486" />
                </>
            )}
            {pose === 'sip' && (
                <>
                    {[-EX, EX].map((x) => <path class="m-closed" d={`M${x - 28} ${EY + 2} q28 16 56 0`} />)}
                </>
            )}
            {pose === 'shock' && (
                <>
                    {[-EX, EX].map((x) => <g class="m-eye"><circle class="m-white" cx={x} cy={EY - 8} r="46" /><circle class="m-pupil" cx={x} cy={EY - 8} r="9" /></g>)}
                    <path class="m-brow" d={`M${-EX - 40} ${EY - 80} L${-EX + 28} ${EY - 70} M${EX + 40} ${EY - 80} L${EX - 28} ${EY - 70}`} />
                    <ellipse class="m-scream" cx="0" cy="-462" rx="32" ry="42" />
                    <path class="m-drop" d="M132 -654 C114 -626 116 -598 134 -594 C152 -598 154 -626 132 -654Z" />
                    <path class="m-shake" d="M-200 -640 l-30 -12 M-206 -594 l-34 0 M200 -640 l30 -12 M206 -594 l34 0" />
                </>
            )}
            {pose === 'relief' && (
                <>
                    {[-EX, EX].map((x) => <path class="m-closed" d={`M${x - 28} ${EY + 6} q28 -14 56 0`} />)}
                    <path class="m-mouth" d="M-14 -484 q8 8 16 0" />
                    <path class="m-exhale-o" d="M150 -500 l52 8 M154 -474 l56 16 M146 -448 l46 24" /><path class="m-exhale" d="M150 -500 l52 8 M154 -474 l56 16 M146 -448 l46 24" />
                </>
            )}
        </g>
        {a.front && (
            <>
                <path class="m-sleeve-o front" d={sleeve(a.l)} /><path class="m-sleeve" d={sleeve(a.l)} />
                <g class="m-mug" transform={`translate(${mugAt!.x} ${mugAt!.y}) rotate(${mugAt!.rot})`}><path class="m-cup" d="M-32 -38 L38 -38 L34 36 L-28 36Z" /><path class="m-handle" d="M38 -18 C64 -18 64 20 36 20" /></g>
                <circle class="m-hand" cx={a.l[2][0]} cy={a.l[2][1]} r="22" />
                <path class="m-steam" d="M2 -526 c-12 -18 12 -28 0 -48 M34 -534 c-12 -18 12 -28 0 -48" />
            </>
        )}
    </g>
</g>
<style is:global>
    .mascot .m-shadow { fill: #0a0a0a; opacity: 0.22; }
    .mascot .m-pants, .mascot .m-shoe { fill: #0a0a0a; stroke: #8a877f; stroke-width: 6; stroke-linejoin: round; }
    .mascot .m-hood { fill: #0a0a0a; stroke: #8a877f; stroke-width: 7; stroke-linecap: round; }
    .mascot .m-hoodie { fill: #0a0a0a; stroke: #8a877f; stroke-width: 7; stroke-linejoin: round; }
    .mascot .m-hem, .mascot .m-pocket { fill: none; stroke: #8a877f; stroke-width: 6; stroke-linecap: round; stroke-linejoin: round; }
    .mascot .m-neck { fill: #f2f0ea; }
    .mascot .m-string { fill: none; stroke: #8a877f; stroke-width: 6; stroke-linecap: round; }
    .mascot .m-tip { fill: #8a877f; }
    .mascot .m-sleeve-o { fill: none; stroke: #8a877f; stroke-width: 58; stroke-linecap: round; stroke-linejoin: round; }
    .mascot .m-sleeve-o.front { stroke-width: 64; }
    .mascot .m-sleeve { fill: none; stroke: #0a0a0a; stroke-width: 46; stroke-linecap: round; stroke-linejoin: round; }
    .mascot .m-hand { fill: #f2f0ea; stroke: #0a0a0a; stroke-width: 6; }
    .mascot .m-cup { fill: #f2f0ea; stroke: #0a0a0a; stroke-width: 7; stroke-linejoin: round; }
    .mascot .m-handle { fill: none; stroke: #f2f0ea; stroke-width: 10; }
    .mascot .m-coffee { fill: #2e2d2a; }
    .mascot .m-steam { fill: none; stroke: #8a877f; stroke-width: 7; stroke-linecap: round; }
    .mascot .m-spill { fill: #2e2d2a; stroke: #0a0a0a; stroke-width: 5; }
    .mascot .m-sheet { fill: #f2f0ea; stroke: #0a0a0a; stroke-width: 7; stroke-linejoin: round; }
    .mascot .m-head { fill: #f2f0ea; stroke: #0a0a0a; stroke-width: 8; }
    .mascot .m-white { fill: #ffffff; stroke: #0a0a0a; stroke-width: 7; }
    .mascot .m-lid { stroke: #0a0a0a; stroke-width: 8; stroke-linecap: round; }
    .mascot .m-pupil { fill: #0a0a0a; }
    .mascot .m-closed, .mascot .m-mouth { fill: none; stroke: #0a0a0a; stroke-width: 8; stroke-linecap: round; }
    .mascot .m-brow { fill: none; stroke: #0a0a0a; stroke-width: 14; stroke-linecap: round; }
    .mascot .m-shake { fill: none; stroke: #ffd400; stroke-width: 9; stroke-linecap: round; }
    .mascot .m-exhale-o { fill: none; stroke: #0a0a0a; stroke-width: 16; stroke-linecap: round; }
    .mascot .m-exhale { fill: none; stroke: #f2f0ea; stroke-width: 8; stroke-linecap: round; }
    .mascot .m-scream { fill: #0a0a0a; }
    .mascot .m-drop { fill: #dcd9d1; stroke: #0a0a0a; stroke-width: 5; }
</style>
