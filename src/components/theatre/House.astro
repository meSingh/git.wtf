---
// The house: one tiny door with a painted sign, a chimney, a number on the roof. Origin at the middle of its base.
// .shell scales (bulge, deflate); .flatdoor is the door left lying on the floor once the house is flat.
import { rect, rough } from '../../theatre/rough';
interface Props { sign: string; number?: number; x?: number }
const { sign, number, x = 800 } = Astro.props;
---
<g class="house" transform={`translate(${x} 760)`}>
    <g class="shell">
        <rect class="walls" x="-130" y="-200" width="260" height="200" rx="6" />
        <path class="walls-edge" d={rect(-130, -200, 260, 200, 61, 2)} />
        <g class="chimney">
            <path d={rect(62, -318, 40, 84, 62, 1.6)} />
        </g>
        <path class="roof" d={rough([[-158, -196], [0, -312], [158, -196]], 64, 2.4)} />
        {number !== undefined && <text class="roofnum" x="0" y="-222">0</text>}
        <g class="door">
            <path d={rect(-28, -112, 56, 112, 65, 1.4)} />
            <circle class="knob" cx="16" cy="-56" r="3.4" />
        </g>
        <g class="sign">
            <path d={rect(-58, -150, 116, 30, 66, 1.4)} />
            <text x="0" y="-129">{sign}</text>
        </g>
    </g>
    <g class="flatdoor" style="visibility:hidden">
        <path d={rect(-30, -8, 60, 8, 67, 1)} />
    </g>
</g>
