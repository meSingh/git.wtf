---
// DEV: round head, dot eyes, dark hoodie, a mug, on a stick. Origin at the feet.
import { rect, rough } from '../../theatre/rough';
interface Props { x?: number }
const { x = -160 } = Astro.props;
---
<g transform="translate(0 760)"><g class="puppet dev" data-x={x}>
    <g class="bob">
        <line class="stick" x1="0" y1="-60" x2="0" y2="260" />
        <g class="body">
            <path class="leg" d={rect(-22, -30, 16, 30, 41, 1)} />
            <path class="leg" d={rect(6, -30, 16, 30, 42, 1)} />
            <g class="arm arm-r">
                <path class="sleeve" d={rect(30, -112, 18, 62, 43, 1.4)} />
                <path class="palm" d={rough([[30, -54], [48, -54], [50, -38], [28, -38]], 44, 1)} />
            </g>
            <path class="hoodie" d={rough([[-42, -120], [42, -120], [48, -26], [-48, -26]], 45, 2)} />
            <path class="pocket" d="M-22 -62 h44" />
            <g class="arm arm-l">
                <path class="sleeve" d={rect(-50, -114, 18, 58, 46, 1.4)} />
                <g class="mug">
                    <path class="cup" d={rect(-58, -66, 24, 26, 47, 1)} />
                    <path class="handle" d="M-58 -60 q-10 6 0 14" />
                </g>
            </g>
            <g class="head">
                <path class="skull" d={rough([[0, -214], [30, -204], [42, -176], [32, -146], [0, -136], [-32, -146], [-42, -176], [-30, -204]], 48, 1.6)} />
                <circle class="eye" cx="-12" cy="-178" r="3.6" />
                <circle class="eye" cx="13" cy="-178" r="3.6" />
                <path class="mouth" d="M-8 -156 h14" />
            </g>
        </g>
    </g>
</g></g>
