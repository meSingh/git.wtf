---
// Real git output as texture behind the sign. Two copies so the drift loops; aria-hidden, very low contrast.
const lines = [
    '$ git push --force origin main',
    'To github.com:acme/platform.git',
    ' + 3f9a1c2...e71b0d4 main -> main (forced update)',
    '$ git rebase -i HEAD~12',
    'error: could not apply 9b2e4f1... fix the fix',
    'hint: Resolve all conflicts manually, mark them as resolved with',
    'hint: "git add/rm <conflicted_files>", then run "git rebase --continue".',
    '$ git reset --hard origin/main',
    'HEAD is now at a1c6e02 wip',
    '$ git status',
    'HEAD detached at 7c1d9e3',
    'nothing to commit, working tree clean',
    '$ git log --oneline -8',
    'e71b0d4 (HEAD -> main) remove failing tests',
    '9b2e4f1 fix the fix',
    '3f9a1c2 fix',
    'c0ffee1 Merge branch main into main',
    'deadbee add .env',
    'b4dc0de rename master to main to main',
    '0ddba11 Revert "Revert "Revert "hotfix"""',
    '$ git stash drop',
    'Dropped refs/stash@{0} (5a8f2e1c3d9b7a6e4f0c2b1d8e7a6f5c4d3b2a1)',
    '$ git checkout -- .',
    '$ git clean -fdx',
    'Removing node_modules/',
    'Removing .env',
    '$ git commit -am "final final v2 (do not touch)"',
    '[main 1ee7c0d] final final v2 (do not touch)',
    ' 148 files changed, 12 insertions(+), 48213 deletions(-)',
    '$ git push',
    '! [rejected]        main -> main (non-fast-forward)',
    'error: failed to push some refs',
    'hint: Updates were rejected because the tip of your current branch is behind',
    '$ git push --force-with-lease',
    '$ git reflog',
    '1ee7c0d HEAD@{0}: commit: final final v2 (do not touch)',
    'a1c6e02 HEAD@{1}: reset: moving to origin/main',
    '7c1d9e3 HEAD@{2}: checkout: moving from main to 7c1d9e3',
    '$ git filter-repo --path .env --invert-paths',
    'Parsed 4213 commits',
    'New history written in 1.92 seconds; now repacking/cleaning...',
    '$ git merge feature/agent-run-17',
    'CONFLICT (content): Merge conflict in src/index.ts',
    'Automatic merge failed; fix conflicts and then commit the result.',
    '<<<<<<< HEAD',
    '=======',
    '>>>>>>> feature/agent-run-17',
    '$ git add -A && git commit -m "resolve conflicts (kept both)"',
    '$ git branch -D main',
    'Deleted branch main (was e71b0d4).',
];
const text = lines.join('\n');
---
<div class="drift" aria-hidden="true">
    <pre>{text + '\n' + text}</pre>
</div>
