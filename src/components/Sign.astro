---
import Flaps from './Flaps.astro';
interface Props { days: number | null; since: string | null }
const { days, since } = Astro.props;
---
<div class="sign" id="sign">
    <div class="sign-frame">
        <div class="sign-face">
            <span class="sign-edge" aria-hidden="true"></span>
            <i class="sign-rivet tl" aria-hidden="true"></i><i class="sign-rivet tr" aria-hidden="true"></i><i class="sign-rivet bl" aria-hidden="true"></i><i class="sign-rivet br" aria-hidden="true"></i>
            <h1 class="sign-title">Days since the last Git fuck-up</h1>
            <div class="sign-board">
                <Flaps value={days} min={2} since={since} class="hero-flaps" label={`${days ?? 'unknown'} days since the last Git fuck-up`} />
                <span class="sign-unit" aria-hidden="true">days</span>
            </div>
        </div>
    </div>
</div>
