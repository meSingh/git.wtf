---
// The footer (Mandeep's pick, 7 Nov 2026: concept A2, cast layout 1): the site's end credits, seven generic rows
// from Content that never change with an incident; the cast along the bottom (a sweeper, a sleeper, one mid-bonk,
// THE EXTRA waving behind its stack, DEV walking off); a short yellow end card with the mark on a black plate, the
// four accounts, the site's links and the bonked line, an agent peeking over its edge; then his line on the black
// strip at the very bottom. The cast and its styles come from the foot-cast partial, fetched by the script as the
// footer approaches, so the first paint carries none of it; the credits roll up once when the footer arrives.
import Logo from './Logo.astro';
import { SITE, href } from '../lib/site';
import '../styles/footer.css';
const c = SITE.credit;
// small one-colour marks for the four accounts, drawn in the button's colour
const ICONS: Record<string, string> = {
    Instagram: '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2.2"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2.2"/><circle cx="17.4" cy="6.6" r="1.4" fill="currentColor"/>',
    'YouTube Shorts': '<rect x="1.5" y="5" width="21" height="14" rx="4" fill="currentColor"/><path d="M10 8.8v6.4l5.6-3.2z" class="ko"/>',
    X: '<path d="M4 3h4.6l4 5.6L17.4 3h2.4l-6.1 7.1L20.5 21h-4.6l-4.3-6-5.2 6H4l6.4-7.4z" fill="currentColor"/>',
    LinkedIn: '<rect x="2" y="2" width="20" height="20" rx="3" fill="currentColor"/><path d="M6 10h2.6v8H6zM7.3 5.6a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zM10.4 10H13v1.1c.4-.7 1.3-1.3 2.6-1.3 2.4 0 2.9 1.5 2.9 3.6V18h-2.6v-4c0-1-.1-2-1.3-2s-1.6.9-1.6 2v4h-2.6z" class="ko"/>',
};
// Content's A2 generic credits (notes/content/footer-concepts-copy.md), the Coordinator's cut of seven; the command in the code face
const credits: [string, string][] = [
    ['Starring', 'AI agents, as themselves'],
    ['Also starring', 'Humans, occasionally'],
    ['The developer', 'DEV, still holding the mug'],
    ['The little grey one', 'Uncredited, as usual'],
    ['Written by', 'Whoever pushed last'],
    ['Stunts', '<code>--force</code>'],
    ['Catering', 'Cold coffee'],
];
---
<footer class="foot" data-foot data-cast={href('/foot-cast/')}>
    <div class="foot-credits">
        <div class="col roll">
            <p class="roll-head">The end</p>
            {credits.map(([k, v]) => <p class="cr"><span class="ck">{k}</span><span class="cv" set:html={v} /></p>)}
        </div>
    </div>
    <div class="foot-card">
        <div class="col foot-card-in">
            <a class="foot-mark" href={href('/')} aria-label="git.wtf, home"><Logo height="clamp(2.6rem, 7vw, 4.8rem)" title="" /></a>
            <p class="foot-follow">Follow the count</p>
            <nav class="foot-social" aria-label="git.wtf elsewhere">
                {SITE.social.filter((s) => !s.placeholder).map((s) => <a class="foot-btn" href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`git.wtf on ${s.name}`}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[s.name] ?? ''} />{s.name}</a>)}
            </nav>
            <p class="foot-row">
                <nav class="foot-nav" aria-label="Site"><a href={href('/incidents/')}>Incidents</a><a href={href('/archive/')}>Archive</a><a href={href('/rss.xml')}>RSS</a><a href={href('/privacy-policy/')}>Privacy</a><a href={href('/terms-of-service/')}>Terms</a></nav>
                <span class="foot-last">
                    <span>No agents were harmed in the making of this site. Several were bonked.</span>
                    <svg class="bonked" viewBox="0 0 120 92" width="44" height="34" aria-hidden="true"><path d="M62 6 l5 12 13 1 -10 8 4 13 -12 -7 -12 7 4 -13 -10 -8 13 -1z" fill="#0a0a0a" /><path d="M100 14 l3 7 8 1 -6 5 2 8 -7 -4 -7 4 2 -8 -6 -5 8 -1z" fill="#0a0a0a" /><path d="M18 22 l3 7 8 1 -6 5 2 8 -7 -4 -7 4 2 -8 -6 -5 8 -1z" fill="#0a0a0a" /><ellipse cx="60" cy="34" rx="16" ry="9" fill="#f2f0ea" stroke="#0a0a0a" stroke-width="3" /><rect x="24" y="36" width="72" height="52" rx="6" fill="#f2f0ea" stroke="#0a0a0a" stroke-width="3" /><rect x="31" y="43" width="58" height="38" rx="3" fill="#0a0a0a" /><text x="40" y="70" fill="#ffd400" font-family="JetBrains Mono, ui-monospace, monospace" font-size="20">&gt;_</text></svg>
                </span>
            </p>
        </div>
    </div>
    <div class="foot-strip"><p class="col credit"><a class="credit-name" href={SITE.owner.url} target="_blank" rel="noopener noreferrer">{c.name}</a>, {c.before}<em>{c.strong}</em>{c.after}<em>{c.last}</em></p><p class="col disclaimer">git.wtf is a parody. Each episode starts from a real incident and is played for laughs, so some details are made up. Please don't read it as news. <a href={href('/terms-of-service/')}>Terms</a></p></div>
</footer>
