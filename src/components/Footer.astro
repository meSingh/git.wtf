---
// The footer, as loud as the page: the wordmark large, the credit line in display type with its two emphasised
// parts, the project's own accounts from one list (only the ones with a URL), and the site's own links.
import Logo from './Logo.astro';
import { SITE, href } from '../lib/site';
const social = SITE.social.filter((s) => s.url);
const icons: Record<string, string> = {
    X: 'M18.2 2h3.4l-7.4 8.5L23 22h-6.8l-5.3-7-6.1 7H1.4l7.9-9.1L1 2h7l4.8 6.4zm-1.2 18h1.9L7.1 3.9H5.1z',
    LinkedIn: 'M6.9 8.5v12.1H3V8.5zM5 2.8a2.2 2.2 0 1 1 0 4.4 2.2 2.2 0 0 1 0-4.4zM21 13.4v7.2h-3.9v-6.5c0-1.6-.6-2.7-2-2.7-1.1 0-1.7.7-2 1.4-.1.3-.1.6-.1 1v6.8h-3.9s.1-11 0-12.1H13v1.7c.5-.8 1.4-1.9 3.5-1.9 2.6 0 4.5 1.7 4.5 5.1z',
    YouTube: 'M23 7.2a2.9 2.9 0 0 0-2-2C19.2 4.7 12 4.7 12 4.7s-7.2 0-9 .5a2.9 2.9 0 0 0-2 2A30 30 0 0 0 .5 12a30 30 0 0 0 .5 4.8 2.9 2.9 0 0 0 2 2c1.8.5 9 .5 9 .5s7.2 0 9-.5a2.9 2.9 0 0 0 2-2 30 30 0 0 0 .5-4.8 30 30 0 0 0-.5-4.8zM9.7 15.3V8.7l6 3.3z',
    Instagram: 'M12 7.3a4.7 4.7 0 1 0 0 9.4 4.7 4.7 0 0 0 0-9.4zm0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm5.9-7.9a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0zM21 8.2c-.1-1.5-.4-2.8-1.5-3.9S17.1 2.9 15.6 2.8C14.1 2.7 9.9 2.7 8.4 2.8 6.9 2.9 5.6 3.2 4.5 4.3S3 6.7 2.9 8.2C2.8 9.7 2.8 14.3 2.9 15.8c.1 1.5.4 2.8 1.5 3.9s2.4 1.4 3.9 1.5c1.5.1 6.1.1 7.6 0 1.5-.1 2.8-.4 3.9-1.5s1.4-2.4 1.5-3.9c.1-1.5.1-6.1 0-7.6zm-2 9.3a3 3 0 0 1-1.7 1.7c-1.2.5-4 .4-5.3.4s-4.1.1-5.3-.4A3 3 0 0 1 5 17.5c-.5-1.2-.4-4-.4-5.3s-.1-4.1.4-5.3A3 3 0 0 1 6.7 5.2c1.2-.5 4-.4 5.3-.4s4.1-.1 5.3.4A3 3 0 0 1 19 6.9c.5 1.2.4 4 .4 5.3s.1 4.1-.4 5.3z',
};
const c = SITE.credit;
---
<footer class="foot">
    <div class="col foot-in">
        <p class="foot-big">The count resets when someone fucks up. Someone always does.</p>
        <p class="credit">{c.name}, {c.before}<em>{c.strong}</em>{c.after}<em>{c.last}</em></p>
        <div class="foot-rows">
            {social.length > 0 && (
                <nav class="foot-social" aria-label="Follow the count">
                    <span class="foot-follow">Follow the count</span>
                    {social.map((s) => <a href={s.url} rel="noopener" aria-label={`git.wtf on ${s.name}`}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d={icons[s.name]} fill="currentColor" /></svg><span>{s.name}</span></a>)}
                </nav>
            )}
            <nav class="foot-nav" aria-label="Site">
                <a href={href('/incidents/')}>Incidents</a>
                <a href={href('/archive/')}>Archive</a>
                <a href={href('/rss.xml')}>RSS</a>
            </nav>
        </div>
        <p class="foot-last"><a class="foot-mark" href={href('/')} aria-label="git.wtf, home"><Logo height="1.6rem" title="" /></a><span>Every fuck-up on this site links to its source.</span></p>
    </div>
</footer>
