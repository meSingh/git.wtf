---
// The footer, quiet: the count line, his credit line with its two emphasised parts, the project's four accounts as
// small bordered buttons from one list, and the site's own links.
import Logo from './Logo.astro';
import { SITE, href } from '../lib/site';
const c = SITE.credit;
---
<footer class="foot">
    <div class="foot-stripe" aria-hidden="true"></div>
    <div class="col foot-in">
        <div class="foot-top">
            <a class="foot-mark" href={href('/')} aria-label="git.wtf, home"><Logo height="clamp(2.4rem, 6vw, 4rem)" title="" /></a>
            <p class="foot-line">The count resets when someone fucks up. Someone always does.</p>
        </div>
        <p class="credit">{c.name}, {c.before}<em>{c.strong}</em>{c.after}<em>{c.last}</em></p>
        <div class="foot-rows">
            <nav class="foot-social" aria-label="git.wtf elsewhere">
                {SITE.social.map((s) => <a class="foot-btn" href={s.url} rel="noopener" aria-label={`git.wtf on ${s.name}`}>{s.name}</a>)}
            </nav>
            <nav class="foot-nav" aria-label="Site">
                <a href={href('/incidents/')}>Incidents</a>
                <a href={href('/archive/')}>Archive</a>
                <a href={href('/rss.xml')}>RSS</a>
            </nav>
        </div>
        <p class="foot-last">No agents were harmed in the making of this site. Several were bonked.</p>
    </div>
</footer>
