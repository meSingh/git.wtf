---
// wiped-worktree: work that was never committed, removed by something that checked and found nothing to lose.
// sweep: a nightly cleanup crosses a grid of worktrees. agents: twelve agents in one checkout.
// wrongdir: the right command in the wrong directory.
import type { BitSetup } from '../../lib/bits';
interface Props { setup: BitSetup; title: string; command: string | null }
const { setup } = Astro.props;
const v = setup.variant;
const p = setup.params as Record<string, number>;
const fmt = (n: number) => n.toLocaleString('en-GB');
const tiles = Array.from({ length: 40 }, (_, i) => i);
const live = 26;
---
{v === 'agents' ? (
    <div class="ww agents">
        <div class="folder box" aria-hidden="true">
            <span class="lbl">one checkout</span>
            <div class="chips">{Array.from({ length: p.agents }, (_, i) => <span class="chip-a">agent-{String(i + 1).padStart(2, '0')}</span>)}</div>
        </div>
        <div class="counts" aria-hidden="true">
            <p class="box"><span class="num" data-count>0</span><span class="dim">of {fmt(p.files)} uncommitted files left</span></p>
            <p class="box"><span class="num clock" data-count>{p.minutes}</span><span class="dim">minutes</span></p>
        </div>
        <div class="out box" aria-hidden="true">
            <p class="ln">repair: created rescue branch</p>
            <p class="ln">cleanup: deleted rescue branch <span class="dim">(unconditionally)</span></p>
            <p class="ln">$ git stash list <span class="dim">(nothing)</span></p>
            <p class="ln">$ git reflog <span class="dim">(no entry)</span></p>
        </div>
        <button class="bit-go" type="button" hidden>{setup.go}</button>
    </div>
) : v === 'wrongdir' ? (
    <div class="ww wrongdir">
        <div class="dirs" aria-hidden="true">
            <div class="d box here">
                <span class="lbl">~/repo, the main checkout</span>
                <p><span class="num" data-count>0</span> <span class="dim">of {p.files} modified files</span></p>
                <p class="y cwd">the shell is here</p>
            </div>
            <div class="d box">
                <span class="lbl">~/repo-wt, the linked worktree</span>
                <p class="dim">the one it meant. Untouched.</p>
            </div>
        </div>
        <div class="out box" aria-hidden="true">
            <p class="ln">~/repo $ git checkout -- .</p>
            <p class="ln dim nothing"> </p>
            <p class="ln dim">(Git prints nothing. It never has.)</p>
            <p class="ln">$ git fsck --lost-found</p>
            <p class="ln">dangling blob 8c41f0e2d7 <span class="dim">(no name)</span></p>
            <p class="ln">dangling blob 2be9a5c1f3 <span class="dim">(no name)</span></p>
        </div>
        <button class="bit-go" type="button" hidden>{setup.go}</button>
    </div>
) : (
    <div class="ww sweep">
        <div class="grid" aria-hidden="true">
            {tiles.map((i) => <i class={`t${i === live ? ' live' : ''}`}>{i === live ? 'in use' : ''}</i>)}
            <i class="broom"></i>
            <span class="fall">deliverables/ <span class="dim">ignored</span></span>
        </div>
        <div class="out box" aria-hidden="true">
            <p class="ln">$ git status --porcelain <span class="dim">(nothing: ignored files are not listed)</span></p>
            <p class="ln">$ git worktree remove --force</p>
        </div>
        {p.removed && (
            <div class="counts" aria-hidden="true">
                <p class="box"><span class="num" data-count>{fmt(p.removed)}</span><span class="dim">worktrees removed, {p.repos} repositories</span></p>
                <p class="box"><span class="num" data-count>{p.ignored}</span><span class="dim">files in ignored paths</span></p>
                <p class="box"><span class="num" data-count>{p.rebuilt}</span><span class="dim">rebuilt from transcripts</span></p>
            </div>
        )}
        <button class="bit-go" type="button" hidden>{setup.go}</button>
    </div>
)}
<style>
    .ww { display: grid; gap: 0.9rem; align-content: start; height: 100%; }
    .counts { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 0.7rem; }
    .counts p { margin: 0; display: grid; gap: 0.2rem; }
    .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .chip-a { border: 1px solid var(--line-2); padding: 0.15rem 0.45rem; }
    .dirs { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
    .dirs p { margin: 0; }
    .here { border-color: var(--yellow); }
    .grid { position: relative; display: grid; grid-template-columns: repeat(10, 1fr); gap: 0.35rem; overflow: hidden; padding-bottom: 1.6rem; }
    .t { display: block; aspect-ratio: 1.6; border: 1px dashed var(--line); font-style: normal; font-size: 0.62em; color: var(--yellow); display: grid; place-items: center; }
    .t.live { border: 1px dashed var(--yellow); }
    .broom { position: absolute; top: 0; bottom: 1.6rem; left: 0; width: 1.4rem; background: repeating-linear-gradient(-45deg, var(--yellow) 0 0.35rem, var(--black) 0.35rem 0.7rem); transform: translateX(-200%); }
    .fall { position: absolute; left: 60%; bottom: 0; white-space: nowrap; color: var(--paper); opacity: 0.55; }
    @media (max-width: 560px) { .dirs { grid-template-columns: 1fr; } .grid { grid-template-columns: repeat(8, 1fr); } }
</style>
