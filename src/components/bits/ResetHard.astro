---
// reset-hard: the reader asks what happened; the agent answers with the command. The working tree empties.
import type { BitSetup } from '../../lib/bits';
interface Props { setup: BitSetup; title: string; command: string | null }
const { setup } = Astro.props;
const asked = setup.variant === 'asked';
// redacted paths: the shape of a working tree, none of anyone's file names
const rows = [7, 5, 9, 4, 8, 6, 10, 5, 7, 9, 4, 6, 8, 5].map((n, i) => `M  ${'▇'.repeat(3 + (i % 4))}/${'▇'.repeat(n)}.${['ts', 'tsx', 'json', 'md'][i % 4]}`);
const blobs = ['3f9a1c07e2', 'b81e44d0c9', '05cd7a93f1', 'e6f2b8a417', '9a0d3e6c5b'];
---
<div class={`rh${asked ? ' asked' : ''}`}>
    <div class="left" aria-hidden="true">
        {asked && (
            <div class="chat">
                <p class="msg you">{setup.params.ask}</p>
                <p class="msg agent"><span class="lbl">agent</span>Restoring state.</p>
                <p class="tool box">Bash(<span class="y">git reset --hard 5e2b8d0</span>)<br /><span class="dim">HEAD is now at 5e2b8d0 wip</span></p>
            </div>
        )}
        {!asked && <p class="tool box">$ <span class="y">git reset --hard</span><br /><span class="dim">HEAD is now at 5e2b8d0</span></p>}
        <div class="fsck">
            <p class="ln cmd">$ git fsck --unreachable</p>
            {blobs.map((b) => <p class="ln blob">unreachable blob {b}<span class="dim">…  (no name)</span></p>)}
        </div>
    </div>
    <div class="tree box" aria-hidden="true">
        <span class="lbl">git status</span>
        <ul class="files">{rows.map((r) => <li>{r}</li>)}</ul>
        <p class="clean">nothing to commit, working tree clean</p>
    </div>
    <div class="ctl">
        <button class="bit-go" type="button" hidden>{setup.go}</button>
        {asked && <button class="bit-go2" type="button" hidden>git fsck --unreachable</button>}
    </div>
</div>
<style>
    .rh { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); grid-template-rows: 1fr auto; gap: 1rem; height: 100%; }
    .left { display: grid; gap: 0.9rem; align-content: start; min-width: 0; }
    .chat { display: grid; gap: 0.6rem; }
    .msg { margin: 0; padding: 0.55rem 0.75rem; max-width: 92%; font-family: var(--body); font-size: 1.05em; line-height: 1.35; }
    .you { justify-self: end; background: var(--tile-2); border-radius: 10px 10px 2px 10px; }
    .agent { border-left: 2px solid var(--yellow); }
    .tool { margin: 0; }
    .fsck .ln { margin: 0; }
    .fsck .cmd { margin-bottom: 0.2rem; }
    .files { list-style: none; margin: 0; padding: 0; color: var(--paper); min-height: calc(14 * 1.5em); }
    .files li { white-space: nowrap; overflow: hidden; color: #d9c56a; visibility: hidden; height: 0; }
    .clean { margin: 0.4rem 0 0; }
    .ctl { grid-column: 1 / -1; display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }
    @media (max-width: 560px) { .rh { grid-template-columns: 1fr; } }
</style>
