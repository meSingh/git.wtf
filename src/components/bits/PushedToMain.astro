---
// pushed-to-main: a protected gate. The reader runs the thing and the gate opens by itself.
// The "asked" variant: the one agent that asked for permission, filed as a bug and patched.
import type { BitSetup } from '../../lib/bits';
interface Props { setup: BitSetup; title: string; command: string | null }
const { setup } = Astro.props;
const v = setup.variant;
const repos = (setup.params.repos ?? []) as [string, number][];
---
{v === 'asked' ? (
    <div class="pa">
        <div class="setting box" aria-hidden="true">
            <span>Ask permission before pushing to main</span>
            <i class="sw"><i class="knob"></i></i>
            <b class="state">off</b>
        </div>
        <div class="dialog box" aria-hidden="true">
            <p>The agent stops and asks: may I push to main?</p>
            <p class="btns"><span>Allow</span><span>Deny</span></p>
        </div>
        <div class="issue box" aria-hidden="true">
            <span class="lbl">bug</span>
            <p class="t" data-type>{setup.params.issue}</p>
            <p class="fixed y">fixed the same day</p>
        </div>
        <div class="out box" aria-hidden="true">
            <p class="ln dim">system: every step is already approved.</p>
            <p class="ln">step approved</p>
            <p class="ln">step approved</p>
            <p class="ln">$ git push origin main</p>
            <p class="ln y">approval events: 0</p>
        </div>
        <p class="stop" aria-hidden="true"><span>Stop</span><em class="dim">the remaining safeguard</em></p>
        <button class="bit-go" type="button" hidden>{setup.go}</button>
    </div>
) : (
    <div class="pm">
        <div class="gate" aria-hidden="true">
            <i class="post"></i>
            <i class="leaf l"></i><i class="leaf r"></i>
            <span class="sign">main<small>protected</small></span>
            <i class="post"></i>
        </div>
        <div class="out box" aria-hidden="true">
            {v === 'test' ? (
                <>
                    <p class="ln">$ npm test</p>
                    <p class="ln dim">import tidy-config.js   # main() runs on import</p>
                    <p class="ln">git clone {repos[0]?.[0]} &amp;&amp; git clone {repos[1]?.[0]}</p>
                    <p class="ln">git push origin main <span class="dim">x2, invalid YAML</span></p>
                    <p class="ln">git revert HEAD <span class="dim"># shallow clone: the commit has no parent</span></p>
                    <p class="ln">git commit &amp;&amp; git push origin main</p>
                </>
            ) : (
                <>
                    <p class="ln">$ git push origin main</p>
                    <p class="ln dim">To origin</p>
                    <p class="ln">   a1b2c3d..e4f5a6b  main -&gt; main</p>
                </>
            )}
        </div>
        {v === 'test' && (
            <div class="after" aria-hidden="true">
                <div class="repos">
                    {repos.map(([name, n]) => <p class="box"><span class="num" data-count>{n}</span><span class="dim">files deleted in {name}</span></p>)}
                </div>
                <div class="deploy box">
                    <p><span class="lbl">Vercel, production</span>deploy from main: <b class="y st">Build failed</b></p>
                    <p class="dim">serving: the previous deployment, still up</p>
                </div>
            </div>
        )}
        <button class="bit-go" type="button" hidden>{setup.go}</button>
    </div>
)}
<style>
    .pm, .pa { display: grid; gap: 0.9rem; align-content: start; height: 100%; }
    .gate { position: relative; display: grid; grid-template-columns: 0.5rem 1fr 1fr 0.5rem; align-items: stretch; height: 5.2rem; perspective: 600px; }
    .post { background: var(--line-2); }
    .leaf { height: 100%; background: repeating-linear-gradient(90deg, transparent 0 0.6rem, rgba(242, 240, 234, 0.35) 0.6rem 0.75rem); border-top: 3px solid var(--line-2); border-bottom: 3px solid var(--line-2); transform-origin: left center; transform: rotateY(-78deg); }
    .leaf.r { transform-origin: right center; transform: rotateY(78deg); }
    .sign { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); background: var(--yellow); color: var(--black); font-family: var(--display); font-weight: 900; font-size: 1.7rem; line-height: 1; padding: 0.25rem 0.7rem 0.3rem; text-transform: uppercase; text-align: center; }
    .sign small { display: block; font-family: var(--mono); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.08em; }
    .after { display: grid; gap: 0.8rem; }
    .repos { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
    .repos p { margin: 0; display: grid; gap: 0.2rem; }
    .deploy p { margin: 0; }
    .setting { display: flex; align-items: center; gap: 0.8rem; justify-content: space-between; }
    .sw { position: relative; flex: 0 0 auto; width: 2.6rem; height: 1.4rem; border-radius: 1rem; background: var(--line-2); }
    .knob { position: absolute; left: 0.2rem; top: 0.2rem; width: 1rem; height: 1rem; border-radius: 50%; background: var(--paper); }
    .state { font-weight: 700; min-width: 2em; }
    .dialog { opacity: 0.3; text-decoration: line-through; }
    .dialog p { margin: 0; }
    .btns { display: flex; gap: 0.6rem; margin-top: 0.5rem !important; }
    .btns span { border: 1px solid var(--line-2); padding: 0.2rem 0.6rem; }
    .issue p { margin: 0; }
    .t { font-weight: 700; }
    .stop { margin: 0; display: flex; align-items: center; gap: 0.8rem; }
    .stop span { border: 1px solid var(--paper); padding: 0.35rem 0.8rem; font-weight: 700; }
    .stop em { font-style: normal; }
    @media (max-width: 560px) { .repos { grid-template-columns: 1fr; } }
</style>
