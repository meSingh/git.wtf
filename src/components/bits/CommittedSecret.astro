---
// committed-secret: the reader deletes the file. The playhead drags back through the history and the key is still
// in the commit before; then the clock runs forward to the day someone looked.
import type { BitSetup } from '../../lib/bits';
interface Props { setup: BitSetup; title: string; command: string | null }
const { setup } = Astro.props;
const p = setup.params as { file: string; key: string; added: string; deleted: string; found: string; release?: string };
---
<div class="cs">
    <div class="top" aria-hidden="true">
        <div class="tree box">
            <span class="lbl">public repo, HEAD</span>
            <p class="f">README.md</p>
            <p class="f gone">{p.file}<em>deleted</em></p>
            <p class="f">src/</p>
        </div>
        <div class="view box">
            <span class="lbl">git show <span class="sha">8d1c0fa</span>:{p.file}</span>
            <p class="k">{p.key}: <span class="redact">sk-••••••••••••••••</span></p>
            <p class="dim">still here, one commit back</p>
            <i class="hand"></i>
        </div>
    </div>
    <div class="time" aria-hidden="true">
        <ol>
            <li><b>{p.added}</b><span class="dim">add {p.file}</span></li>
            <li><b>{p.deleted}</b><span class="dim">delete {p.file}</span></li>
            <li><b>{p.found}</b><span class="dim">someone looks</span></li>
        </ol>
        <i class="rail"><i class="head"></i></i>
    </div>
    {p.release && (
        <div class="out box" aria-hidden="true">
            <p class="ln">maintainer token: collected</p>
            <p class="ln">release workflow: changed on main, through branch protection</p>
            <p class="ln y">PyPI: {p.release} published</p>
        </div>
    )}
    <button class="bit-go" type="button" hidden>{setup.go}</button>
</div>
<style>
    .cs { display: grid; gap: 1rem; align-content: start; height: 100%; }
    .top { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 1rem; }
    .f { margin: 0; }
    .f em { font-style: normal; color: var(--yellow); margin-left: 0.6em; }
    .gone { color: var(--grey); text-decoration: line-through; }
    .gone em { text-decoration: none; display: inline-block; }
    .view { position: relative; }
    .view p { margin: 0; }
    .k { font-size: 1.15em; margin: 0.2rem 0 0.4rem !important; }
    .redact { color: var(--yellow); }
    /* a plain pointer, no hand-drawn face: something reaches for the key */
    .hand { position: absolute; right: 1.2rem; top: 2.2rem; width: 0; height: 0; border-left: 0.6rem solid transparent; border-right: 0.6rem solid transparent; border-bottom: 1.1rem solid var(--paper); transform: rotate(-30deg); }
    .time { position: relative; padding-bottom: 1.4rem; }
    .time ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
    .time li { display: grid; gap: 0.15rem; }
    .time li:nth-child(2) { text-align: center; }
    .time li:nth-child(3) { text-align: right; }
    .rail { position: absolute; left: 0; right: 0; bottom: 0.4rem; height: 2px; background: var(--line-2); }
    .head { position: absolute; left: 100%; top: -0.45rem; width: 0.9rem; height: 0.9rem; margin-left: -0.45rem; border-radius: 50%; background: var(--yellow); }
    .out p { margin: 0; }
    @media (max-width: 560px) { .top { grid-template-columns: 1fr; } }
</style>
