---
// The stand-in for a category that has no bit yet: the command, run.
import type { BitSetup } from '../../lib/bits';
interface Props { setup: BitSetup; title: string; command: string | null }
const { setup, title, command } = Astro.props;
---
<div class="gn">
    <div class="out box" aria-hidden="true">
        <p class="ln">$ {command ?? title}</p>
        <p class="ln dim">done.</p>
    </div>
    <button class="bit-go" type="button" hidden>{setup.go}</button>
</div>
<style>
    .gn { display: grid; gap: 1rem; align-content: start; }
</style>
