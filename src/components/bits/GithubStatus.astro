---
// github: a status page that says All Systems Operational while it flickers. The reader pushes; the Git row goes
// amber and back, once per round, each closing with the same sentence. A retry loop ticks in the corner.
import type { BitSetup } from '../../lib/bits';
interface Props { setup: BitSetup; title: string; command: string | null }
const { setup } = Astro.props;
type Round = { day: string; rows: string[]; took?: string; investigating?: boolean };
const rounds = setup.params.rounds as Round[];
const ROWS = ['Git Operations', 'Issues', 'Pull Requests', 'Actions', 'API Requests'];
const SENTENCE = 'Resolved. A detailed root cause analysis will be shared as soon as it is available.';
---
<div class="gh">
    <div class="sp" aria-hidden="true">
        <p class="banner"><span class="ok">All Systems Operational</span></p>
        <p class="inv"><b>Investigating</b> Git Operations is operating normally.</p>
        <ul class="rows">
            {ROWS.map((r) => <li data-row={r}><span>{r}</span><b class="st">Normal</b></li>)}
        </ul>
        <ol class="log">
            {rounds.map((r) => (
                <li><b>{r.day}</b> <span class="dim">{r.rows.join(', ')}{r.took ? `, ${r.took}` : ''}</span><br /><span class="said" data-type>{SENTENCE}</span></li>
            ))}
        </ol>
    </div>
    <div class="loop box" aria-hidden="true">
        <p class="ln">$ while ! git push; do sleep 5; done</p>
        {rounds.map(() => <p class="ln e">error: failed to push some refs</p>)}
        <p class="ln y">   4c1e9b0..7d2a6f3  main -&gt; main</p>
    </div>
    <button class="bit-go" type="button" hidden>{setup.go}</button>
</div>
<style>
    .gh { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.8rem; align-content: start; height: 100%; }
    .sp { background: #f6f8fa; color: #1f2328; padding: 0.8rem 0.9rem; font-family: var(--body); }
    .banner { margin: 0 0 0.6rem; background: #1f883d; color: #fff; padding: 0.55rem 0.8rem; font-weight: 600; border-radius: 4px; }
    .inv { margin: 0 0 0.6rem; color: #1f2328; font-size: 0.92em; }
    .inv b { color: #9a6700; margin-right: 0.4em; }
    .rows { list-style: none; margin: 0; padding: 0; border: 1px solid #d1d9e0; border-radius: 4px; }
    .rows li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.35rem 0.7rem; border-top: 1px solid #d1d9e0; }
    .rows li:first-child { border-top: 0; }
    .st { color: #1a7f37; font-weight: 600; }
    .log { list-style: none; margin: 0.6rem 0 0; padding: 0; display: grid; gap: 0.35rem; font-size: 0.9em; }
    .log .dim { color: #59636e; }
    .said { color: #1f2328; }
    .loop { font-size: 0.92em; }
    .loop .e { color: var(--grey); }
</style>
