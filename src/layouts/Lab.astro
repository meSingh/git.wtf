---
import '../styles/global.css';
import '../styles/hero.css';
import LabNav from '../components/LabNav.astro';
import { SITE } from '../lib/site';

interface Props { title: string; current?: 'a' | 'b' | 'c' }
const { title, current } = Astro.props;
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const fonts = [
    ['big-shoulders-display-latin-wght-normal.woff2', 'Big Shoulders Display', '100 900'],
    ['jetbrains-mono-latin-wght-normal.woff2', 'JetBrains Mono', '100 800'],
    ['geist-latin-wght-normal.woff2', 'Geist', '100 900'],
];
const fontCss = fonts.map(([file, family, weight]) => `@font-face{font-family:'${family}';font-style:normal;font-weight:${weight};font-display:block;src:url(${base}/fonts/${file}) format('woff2')}`).join('');
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} | {SITE.name} hero lab</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={`${base}/fonts/${fonts[0][0]}`} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={`${base}/fonts/${fonts[1][0]}`} />
    <style set:html={fontCss} />
    <script is:inline>
        // Before first paint: decide whether the sequence runs. With reduced motion (or ?reduce) the page is the finished still.
        // If the sequence script has not started within 2.5 s, fall back to the still rather than leave a dark screen.
        (function () {
            var d = document.documentElement, q = location.search;
            if (q.indexOf('embed') > -1) d.classList.add('embed');
            if (matchMedia('(prefers-reduced-motion: reduce)').matches || q.indexOf('reduce') > -1) return;
            d.classList.add('js-anim');
            setTimeout(function () { if (!window.__heroRan) d.classList.remove('js-anim'); }, 2500);
        })();
    </script>
</head>
<body class="lab">
    <slot />
    <LabNav current={current} />
</body>
</html>
