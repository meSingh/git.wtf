---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import Logo from '../components/Logo.astro';
import Flaps from '../components/Flaps.astro';
import Footer from '../components/Footer.astro';
import { SITE, daysSince, happened, href, sortIncidents } from '../lib/site';

interface Props {
    title: string;
    description?: string;
    image?: string;
    canonical?: string;
    type?: 'website' | 'article';
    noindex?: boolean;
    jsonld?: Record<string, unknown>;
    /** Show the live counter badge in the top bar from the start (every page but the homepage). */
    badge?: boolean;
}
const { title, description = SITE.description, image = '/share.png', canonical, type = 'website', noindex = false, jsonld, badge = true } = Astro.props;
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const url = canonical ?? new URL(Astro.url.pathname, SITE.url).toString();
const img = new URL(image.startsWith('/') ? base + image : image, SITE.url).toString();
const incidents = sortIncidents(await getCollection('incidents'));
const latest = incidents[0] ?? null;
const days = daysSince(incidents);
const fonts = [
    ['big-shoulders-display-latin-wght-normal.woff2', 'Big Shoulders Display', '100 900'],
    ['jetbrains-mono-latin-wght-normal.woff2', 'JetBrains Mono', '100 800'],
    ['geist-latin-wght-normal.woff2', 'Geist', '100 900'],
];
const fontCss = fonts.map(([file, family, weight]) => `@font-face{font-family:'${family}';font-style:normal;font-weight:${weight};font-display:swap;src:url(${base}/fonts/${file}) format('woff2')}`).join('');
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" as="font" type="font/woff2" crossorigin href={`${base}/fonts/${fonts[0][0]}`} />
    <style set:html={fontCss} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}/favicon-32.png`} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={`${base}/rss.xml`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={img} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={img} />
    <meta name="theme-color" content="#0a0a0a" />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
    <header class="bar">
        <a class="brand" href={href('/')} aria-label="Git.WTF, home"><Logo height="1.55rem" /></a>
        <a class={`badge${badge ? ' on' : ''}`} id="badge" href={href('/')} aria-label={`${days ?? 'unknown'} days since the last Git fuck-up`}>
            <Flaps value={days} min={2} class="badge-flaps" since={latest ? happened(latest) : null} label="" />
            <span class="badge-label">days since the last Git fuck-up</span>
        </a>
        <nav aria-label="Site">
            <a href={href('/incidents/')}>Incidents</a>
            <a href={href('/archive/')}>Archive</a>
            <a href={href('/rss.xml')}>RSS</a>
        </nav>
    </header>
    <slot />
    <Footer />
    <script>
        import { syncCounters } from '../scripts/flaps';
        syncCounters();
    </script>
</body>
</html>
